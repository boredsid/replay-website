---
/**
 * One unified partners-and-sponsors logo wall.
 * The sponsor-logos directory is the only source of truth.
 */
import { Image } from 'astro:assets';
import type { PartnerLogo } from '../lib/partner-logos';

export interface Props {
  logos: PartnerLogo[];
}

const { logos } = Astro.props;
---

{
  logos.length > 0 && (
    <section class="sponsors-band" aria-labelledby="partners-sponsors-heading">
      <div class="container-x sponsors-band__inner">
        <span class="section-tag">Partners &amp; sponsors</span>
        <h2 id="partners-sponsors-heading" class="sponsors-band__heading">
          The people making REPLAY happen.
        </h2>

        <div class="sponsors-band__grid">
          {logos.map((logo) => (
            <div class="sponsors-band__logo-cell">
              <Image
                src={logo.image}
                alt={logo.name}
                width={240}
                format="webp"
                quality={82}
                loading="lazy"
                class="sponsors-band__logo"
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .sponsors-band {
    background: var(--color-cream);
    border-top: 4px solid var(--color-ink);
    border-bottom: 4px solid var(--color-ink);
  }

  .sponsors-band__inner {
    padding: 64px 24px;
  }

  .sponsors-band__heading {
    max-width: 18ch;
    margin: 8px 0 40px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1.05;
  }

  .sponsors-band__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 24px 18px;
  }

  .sponsors-band__logo-cell {
    display: flex;
    min-width: 0;
    aspect-ratio: 3 / 2;
    align-items: center;
    justify-content: center;
    padding: clamp(14px, 2.5vw, 26px);
    overflow: hidden;
    border: 2px solid rgba(26, 26, 26, 0.14);
    border-radius: var(--radius-md);
    background: #fff;
  }

  .sponsors-band__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 112px;
    object-fit: contain;
  }

  @media (min-width: 640px) {
    .sponsors-band__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .sponsors-band__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }
</style>
