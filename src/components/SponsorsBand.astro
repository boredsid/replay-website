---
/**
 * SponsorsBand
 * -----------------------------------------------------------------
 * Tier-stacked sponsor logos on cream with thick ink borders.
 * Tier order: title → gold → silver → partner.
 * Hidden entirely when no sponsors are present.
 */
import type { SponsorRow } from '../lib/types';

export interface Props {
  sponsors: SponsorRow[];
}

const { sponsors } = Astro.props;

type Tier = 'title' | 'gold' | 'silver' | 'partner';
const TIERS: Tier[] = ['title', 'gold', 'silver', 'partner'];
const TIER_LABEL: Record<Tier, string> = {
  title: 'Title sponsor',
  gold: 'Gold sponsors',
  silver: 'Silver sponsors',
  partner: 'Partners',
};

const grouped: Record<Tier, SponsorRow[]> = {
  title: [],
  gold: [],
  silver: [],
  partner: [],
};
for (const s of sponsors) {
  if (TIERS.includes(s.tier as Tier)) {
    grouped[s.tier as Tier].push(s);
  }
}
---

{
  sponsors.length > 0 && (
    <section class="sponsors-band">
      <div class="container-x sponsors-band__inner">
        <span
          class="section-tag"
          style="background: var(--color-yellow); color: var(--color-ink);"
        >
          SPONSORS
        </span>
        <h2 class="sponsors-band__heading">Backed by</h2>

        {TIERS.map((tier) =>
          grouped[tier].length === 0 ? null : (
            <div class:list={['sponsors-band__tier', `tier-${tier}`]}>
              <div class="sponsors-band__tier-label">{TIER_LABEL[tier]}</div>
              <div class:list={['sponsors-band__grid', `grid-${tier}`]}>
                {grouped[tier].map((sponsor) =>
                  sponsor.website_url ? (
                    <a
                      href={sponsor.website_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[
                        'card-brutal',
                        tier === 'title' && 'card-brutal-lg',
                        'sponsors-band__card',
                      ]}
                      aria-label={sponsor.name}
                    >
                      <img
                        src={sponsor.logo_url}
                        alt={sponsor.name}
                        loading="lazy"
                        decoding="async"
                        class:list={['sponsors-band__logo', `logo-${tier}`]}
                      />
                    </a>
                  ) : (
                    <div
                      class:list={[
                        'card-brutal',
                        tier === 'title' && 'card-brutal-lg',
                        'sponsors-band__card',
                      ]}
                    >
                      <img
                        src={sponsor.logo_url}
                        alt={sponsor.name}
                        loading="lazy"
                        decoding="async"
                        class:list={['sponsors-band__logo', `logo-${tier}`]}
                      />
                    </div>
                  )
                )}
              </div>
            </div>
          )
        )}
      </div>
    </section>
  )
}

<style>
  .sponsors-band {
    background: var(--color-cream);
    border-top: 4px solid var(--color-ink);
    border-bottom: 4px solid var(--color-ink);
  }
  .sponsors-band__inner {
    padding: 64px 24px;
  }

  .sponsors-band__heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--color-ink);
    margin: 8px 0 40px;
  }

  .sponsors-band__tier + .sponsors-band__tier {
    margin-top: 40px;
  }

  .sponsors-band__tier-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #6b7280; /* gray-600 */
    margin-bottom: 12px;
  }

  .sponsors-band__grid {
    display: grid;
    gap: 16px;
  }

  .sponsors-band__card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    background: #fff;
    text-decoration: none;
  }

  .sponsors-band__logo {
    width: 100%;
    object-fit: contain;
    display: block;
  }

  /* Tier-specific grids + logo sizing -------------------- */
  .grid-title {
    grid-template-columns: 1fr;
    max-width: 28rem; /* max-w-md-ish */
    margin: 0 auto;
  }
  .logo-title {
    height: 128px;
  }

  .grid-gold {
    grid-template-columns: repeat(2, 1fr);
  }
  .logo-gold {
    height: 80px;
  }

  .grid-silver {
    grid-template-columns: repeat(2, 1fr);
  }
  .logo-silver {
    height: 64px;
  }

  .grid-partner {
    grid-template-columns: repeat(3, 1fr);
  }
  .logo-partner {
    height: 56px;
  }

  @media (min-width: 768px) {
    .grid-gold {
      grid-template-columns: repeat(3, 1fr);
    }
    .grid-silver {
      grid-template-columns: repeat(4, 1fr);
    }
    .grid-partner {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-partner {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsors-band__card {
      transition: none;
    }
  }
</style>
