---
import type { ScheduleItemRow, ScheduleKind, ScheduleSection, ScheduleSignupMode } from '../lib/types';
import { calendarDate } from '../lib/edition-format';

export interface Props {
  date: string;
  label: string;
  items: ScheduleItemRow[];
}

const { date, label, items } = Astro.props;

const SECTIONS: Array<{ key: ScheduleSection; label: string; intro: string }> = [
  { key: 'always-on', label: 'Explore all day', intro: 'Drop in during event hours unless the listing says otherwise.' },
  { key: 'programme', label: 'Timed programme', intro: 'Sessions, workshops, tournaments and special events in start-time order.' },
  { key: 'playtesting', label: 'Playtests', intro: 'Try games in development and share useful feedback with their designers.' },
  { key: 'publisher-showcase', label: 'Publisher showcases', intro: 'Meet the people behind the games and learn what they are bringing to the table.' },
  { key: 'event-floor', label: 'Around the event floor', intro: 'Booths, food, merch and useful places to find while you explore.' },
];

const KIND_LABEL: Record<ScheduleKind, string> = {
  workshop: 'Workshop',
  tournament: 'Tournament',
  'open-play': 'Open play',
  meal: 'Meal',
  talk: 'Talk',
  ttrpg: 'TTRPG',
  'story-game': 'Story game',
  puzzle: 'Puzzle',
  quiz: 'Quiz',
  'social-game': 'Social game',
  playtest: 'Playtest',
  'publisher-showcase': 'Publisher showcase',
  booth: 'Booth',
  food: 'Food',
  merch: 'Merch',
  amenity: 'Amenity',
  special: 'Special event',
};

const KIND_PILL: Record<ScheduleKind, string> = {
  workshop: 'pill-blue',
  tournament: 'pill-pink',
  'open-play': 'pill-yellow',
  meal: 'pill-green',
  talk: 'pill-purple',
  ttrpg: 'pill-purple',
  'story-game': 'pill-purple',
  puzzle: 'pill-blue',
  quiz: 'pill-yellow',
  'social-game': 'pill-pink',
  playtest: 'pill-green',
  'publisher-showcase': 'pill-accent',
  booth: 'pill-accent',
  food: 'pill-green',
  merch: 'pill-yellow',
  amenity: 'pill-blue',
  special: 'pill-purple',
};

const SIGNUP_LABEL: Record<Exclude<ScheduleSignupMode, 'none'>, string> = {
  'walk-in': 'Walk in',
  advance: 'Advance sign-up',
  'on-site': 'Sign up on site',
};

const hhmm = (time: string | null) => time ? time.slice(0, 5) : '';
const timing = (item: ScheduleItemRow) => item.is_all_day
  ? 'All day'
  : `${hhmm(item.start_time)}–${hhmm(item.end_time)}`;
---

<section class="schedule-day" aria-label={`${label} schedule`}>
  <header class="schedule-day-header">
    <h2 class="schedule-day-label">{label}</h2>
    <span class="schedule-day-date">{calendarDate(date)}</span>
  </header>

  {items.length === 0 ? (
    <p class="schedule-empty">No published items yet.</p>
  ) : (
    SECTIONS.map((section) => {
      const sectionItems = items.filter((item) => item.section === section.key);
      if (sectionItems.length === 0) return null;

      return (
        <section class="schedule-group" aria-labelledby={`${section.key}-${date}`}>
          <div class="schedule-group__header">
            <h3 id={`${section.key}-${date}`}>{section.label}</h3>
            <p>{section.intro}</p>
          </div>

          <div class:list={['schedule-items', section.key === 'programme' && 'schedule-items--timeline']}>
            {sectionItems.map((item) => (
              <article class:list={['schedule-card', item.public_status === 'cancelled' && 'schedule-card--cancelled']}>
                <div class="schedule-card__meta">
                  <span class={`pill ${KIND_PILL[item.kind]}`}>{KIND_LABEL[item.kind]}</span>
                  <span class="schedule-card__time">{timing(item)}</span>
                  {item.public_status === 'cancelled' && <span class="pill pill-cream">Cancelled</span>}
                </div>

                <h4>{item.title}</h4>
                {item.host_name && <p class="schedule-card__host">Hosted by {item.host_name}</p>}
                {item.description && <p class="schedule-card__description">{item.description}</p>}

                {(item.location || item.signup_mode !== 'none') && (
                  <div class="schedule-card__details">
                    {item.location && <span>◆ {item.location}</span>}
                    {item.signup_mode !== 'none' && (
                      item.signup_url && item.public_status !== 'cancelled'
                        ? <a href={item.signup_url} target="_blank" rel="noopener noreferrer">{SIGNUP_LABEL[item.signup_mode]} ↗</a>
                        : <span>{SIGNUP_LABEL[item.signup_mode]}</span>
                    )}
                  </div>
                )}
              </article>
            ))}
          </div>
        </section>
      );
    })
  )}
</section>

<style>
  .schedule-day { margin-bottom: 5rem; }
  .schedule-day-header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-bottom: .8rem; margin-bottom: 2rem; border-bottom: 4px solid var(--color-ink); }
  .schedule-day-label { margin: 0; font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -.03em; }
  .schedule-day-date { font-family: var(--font-heading); font-size: .78rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; opacity: .58; white-space: nowrap; }
  .schedule-empty { padding: 1rem 0; color: rgba(26,26,26,.58); }

  .schedule-group + .schedule-group { margin-top: 3.5rem; }
  .schedule-group__header { display: grid; gap: .45rem; margin-bottom: 1.25rem; }
  .schedule-group__header h3 { font-size: clamp(1.45rem, 4vw, 2rem); }
  .schedule-group__header p { max-width: 68ch; color: rgba(26,26,26,.68); }

  .schedule-items { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 18px; }
  .schedule-card { display: flex; flex-direction: column; min-width: 0; padding: 22px; border: 3px solid var(--color-ink); border-radius: var(--radius-md); background: #fff; box-shadow: var(--shadow-md); }
  .schedule-card--cancelled { opacity: .68; background: var(--color-cream); }
  .schedule-card--cancelled h4 { text-decoration: line-through; }
  .schedule-card__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .schedule-card__time { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: .82rem; font-weight: 800; }
  .schedule-card h4 { margin-top: 16px; font-size: 1.3rem; line-height: 1.2; }
  .schedule-card__host { margin-top: 5px; font-size: .86rem; font-weight: 750; color: rgba(26,26,26,.66); }
  .schedule-card__description { margin-top: 10px; color: rgba(26,26,26,.75); }
  .schedule-card__details { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: auto; padding-top: 18px; font-size: .84rem; font-weight: 700; }
  .schedule-card__details a { color: inherit; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }

  @media (min-width: 760px) {
    .schedule-items--timeline { grid-template-columns: 1fr; }
    .schedule-items--timeline .schedule-card { display: grid; grid-template-columns: minmax(180px, auto) minmax(0, 1fr); column-gap: 24px; align-items: start; }
    .schedule-items--timeline .schedule-card__meta { grid-column: 1; grid-row: 1 / span 4; align-content: start; }
    .schedule-items--timeline .schedule-card h4,
    .schedule-items--timeline .schedule-card__host,
    .schedule-items--timeline .schedule-card__description,
    .schedule-items--timeline .schedule-card__details { grid-column: 2; }
    .schedule-items--timeline .schedule-card h4 { margin-top: 0; }
    .schedule-items--timeline .schedule-card__details { margin-top: 0; }
  }
</style>
