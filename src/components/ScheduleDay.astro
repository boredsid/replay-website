---
import type { ScheduleItemRow } from '../lib/types';

export interface Props {
  date: string;
  label: string;
  items: ScheduleItemRow[];
}

const { date, label, items } = Astro.props;

const KIND_PILL: Record<ScheduleItemRow['kind'], string> = {
  workshop:    'pill-blue',
  tournament:  'pill-pink',
  'open-play': 'pill-yellow',
  meal:        'pill-green',
  talk:        'pill-purple',
};

const KIND_DOT: Record<ScheduleItemRow['kind'], string> = {
  workshop:    'var(--color-blue)',
  tournament:  'var(--color-pink)',
  'open-play': 'var(--color-yellow)',
  meal:        'var(--color-green)',
  talk:        'var(--color-purple)',
};

const hhmm = (t: string) => t.slice(0, 5);
---

<section class="schedule-day" aria-label={`${label} schedule`}>
  <header class="schedule-day-header">
    <h2 class="schedule-day-label">{label}</h2>
    <span class="schedule-day-date">{date}</span>
  </header>

  {items.length === 0 ? (
    <p class="schedule-empty">No items yet.</p>
  ) : (
    <ol class="schedule-timeline">
      {items.map((i) => (
        <li class="schedule-item">
          <span
            class="schedule-dot"
            style={`background: ${KIND_DOT[i.kind]};`}
            aria-hidden="true"
          ></span>

          <div class="schedule-time" aria-label={`${hhmm(i.start_time)} to ${hhmm(i.end_time)}`}>
            <span class="schedule-time-start">{hhmm(i.start_time)}</span>
            <span class="schedule-time-sep" aria-hidden="true">→</span>
            <span class="schedule-time-end">{hhmm(i.end_time)}</span>
          </div>

          <div class="schedule-body">
            <h3 class="schedule-title">{i.title}</h3>
            {i.location && (
              <div class="schedule-location">
                <span class="schedule-loc-marker" aria-hidden="true">◆</span>
                {i.location}
              </div>
            )}
            {i.description && (
              <p class="schedule-description">{i.description}</p>
            )}
          </div>

          <div class="schedule-kind">
            <span class={`pill ${KIND_PILL[i.kind]}`}>{i.kind}</span>
          </div>
        </li>
      ))}
    </ol>
  )}
</section>

<style>
  .schedule-day {
    margin-bottom: 4rem;
  }

  /* ---------- Header ---------- */
  .schedule-day-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    margin-bottom: 2rem;
    border-bottom: 4px solid var(--color-ink);
  }

  .schedule-day-label {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 0;
  }

  .schedule-day-date {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink);
    opacity: 0.55;
    white-space: nowrap;
  }

  /* ---------- Empty state ---------- */
  .schedule-empty {
    font-family: var(--font-body);
    color: rgba(26, 26, 26, 0.55);
    padding: 1rem 0;
  }

  /* ---------- Timeline list ---------- */
  .schedule-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* Vertical rail down the dot column */
  .schedule-timeline::before {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 15px;          /* center of 32px dot column (32 / 2 = 16; line is 2px wide → 15) */
    width: 2px;
    background: rgba(26, 26, 26, 0.22);
    z-index: 0;
  }

  .schedule-item {
    display: grid;
    grid-template-columns: 32px 80px 1fr auto;
    column-gap: 16px;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(26, 26, 26, 0.08);
    position: relative;
  }

  .schedule-item:last-child {
    border-bottom: 0;
  }

  /* ---------- Dot ---------- */
  .schedule-dot {
    grid-column: 1;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--color-ink);
    margin-top: 6px;
    margin-left: 7px;   /* aligns the dot's center with the rail */
    box-shadow: 2px 2px 0 var(--color-ink);
    position: relative;
    z-index: 1;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .schedule-item:hover .schedule-dot {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--color-ink);
  }

  /* ---------- Time block ---------- */
  .schedule-time {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-ink);
    padding-top: 3px;
  }

  .schedule-time-start {
    font-size: 0.95rem;
  }

  .schedule-time-sep {
    font-size: 0.7rem;
    color: rgba(26, 26, 26, 0.35);
    font-weight: 400;
    line-height: 1;
  }

  .schedule-time-end {
    color: rgba(26, 26, 26, 0.55);
    font-weight: 600;
  }

  /* ---------- Body ---------- */
  .schedule-body {
    grid-column: 3;
    min-width: 0;
  }

  .schedule-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0 0 4px;
  }

  .schedule-location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.825rem;
    color: rgba(26, 26, 26, 0.6);
    font-weight: 500;
  }

  .schedule-loc-marker {
    color: var(--color-orange);
    font-size: 0.7rem;
    line-height: 1;
  }

  .schedule-description {
    margin: 6px 0 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(26, 26, 26, 0.75);
  }

  /* ---------- Kind pill ---------- */
  .schedule-kind {
    grid-column: 4;
    padding-top: 4px;
    white-space: nowrap;
  }

  /* ---------- Mobile reflow ---------- */
  @media (max-width: 640px) {
    .schedule-timeline::before {
      left: 11px;
    }

    .schedule-item {
      grid-template-columns: 24px 1fr;
      grid-template-rows: auto auto auto;
      column-gap: 12px;
      row-gap: 4px;
      padding: 1.1rem 0;
    }

    .schedule-dot {
      grid-column: 1;
      grid-row: 1 / 4;
      margin-top: 8px;
      margin-left: 3px;
      align-self: start;
    }

    .schedule-time {
      grid-column: 2;
      grid-row: 1;
      flex-direction: row;
      align-items: baseline;
      gap: 8px;
      padding-top: 0;
    }

    .schedule-time-sep {
      font-size: 0.75rem;
    }

    .schedule-body {
      grid-column: 2;
      grid-row: 2;
    }

    .schedule-kind {
      grid-column: 2;
      grid-row: 3;
      padding-top: 6px;
    }
  }
</style>
