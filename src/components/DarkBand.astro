---
/**
 * DarkBand
 * -----------------------------------------------------------------
 * Full-width slab section. Eyebrow + heading + body + up to two CTAs.
 * Used for hero, Guild Path teaser, closing CTAs, etc. Defaults to a
 * dark ink bg + white text; pass `bg="#FFF8E7"` (or any light hex) AND
 * `tone="light"` for a light-bg variant.
 */

type CtaVariant = 'primary' | 'outline-white' | 'black';
type Tone = 'dark' | 'light';

interface Cta {
  text: string;
  href: string;
  variant?: CtaVariant;
  external?: boolean;
}

export interface Props {
  eyebrow?: string;
  eyebrowColor?: string;
  heading: string;
  body?: string;
  cta?: Cta;
  cta2?: Cta;
  bg?: string;
  tone?: Tone;
}

const {
  eyebrow,
  eyebrowColor,
  heading,
  body,
  cta,
  cta2,
  bg = '#1A1A1A',
  tone = 'dark',
} = Astro.props;

const ctas: Cta[] = [cta, cta2].filter((c): c is Cta => Boolean(c));

const variantClass = (v: CtaVariant | undefined): string => {
  if (v === 'outline-white') return 'btn-outline-white';
  if (v === 'black') return 'btn-black';
  return 'btn-primary';
};

// On dark bg: white text, slightly-faded body. On light bg: ink text + slightly faded body.
const isLight = tone === 'light';
const headingColor = isLight ? '#1A1A1A' : '#FFFFFF';
const bodyColor = isLight ? 'rgba(26, 26, 26, 0.75)' : 'rgba(255, 255, 255, 0.7)';
const eyebrowDefaultColor = isLight ? '#1A1A1A' : '#FFFFFF';
const eyebrowStyle = `color: ${eyebrowColor ?? eyebrowDefaultColor};`;
---

<section class="dark-band" style={`background: ${bg};`}>
  <div class="container-x dark-band__inner">
    {
      eyebrow && (
        <div class="dark-band__eyebrow" style={eyebrowStyle}>
          {eyebrow}
        </div>
      )
    }

    <h2 class="dark-band__heading" style={`color: ${headingColor};`}>{heading}</h2>

    {body && <p class="dark-band__body" style={`color: ${bodyColor};`}>{body}</p>}

    {
      ctas.length > 0 && (
        <div class="dark-band__cta-row">
          {ctas.map((c) => (
            <a
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
              class:list={['btn', variantClass(c.variant)]}
            >
              {c.text}
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .dark-band {
    position: relative;
    overflow: hidden;
  }

  .dark-band__inner {
    position: relative;
    padding: 64px 24px;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .dark-band__inner {
      padding: 96px 24px;
    }
  }

  .dark-band__eyebrow {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
    line-height: 1;
  }

  .dark-band__heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.2rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -1.5px;
    margin: 0;
  }

  .dark-band__body {
    margin-top: 16px;
    max-width: 40rem;
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .dark-band__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @media (prefers-reduced-motion: reduce) {
    .dark-band__cta-row .btn {
      transition: none;
    }
  }
</style>
