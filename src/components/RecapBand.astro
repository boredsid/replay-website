---
/**
 * The homepage band between editions: what the last edition added up to.
 *
 * It takes the place of the dates band, and every word in it is decided in
 * src/lib/recap.ts — this component only lays it out. Figures that are zero
 * or missing never reach it, so an edition without app data (REPLAY 1 and 2)
 * renders a headline and its links, and nothing that reads as "0 people".
 */
import type { RecapView } from '../lib/recap';

export interface Props {
  view: RecapView;
}

const { view } = Astro.props;
const [primary, ...secondary] = view.links;
const hasCards = Boolean(view.mostBorrowed || view.fullest);
---

<section class="recap" aria-labelledby="recap-heading">
  <div class="container-x recap__inner">
    <p class="recap__eyebrow">▸ {view.eyebrow}</p>
    <h2 id="recap-heading" class="recap__heading">{view.headline}</h2>
    {view.sub && <p class="recap__sub">{view.sub}</p>}

    {view.tiles.length > 0 && (
      <dl class="recap__stats">
        {view.tiles.map((tile) => (
          <div class="recap__stat">
            <dt>{tile.label}</dt>
            <dd>{tile.value.toLocaleString('en-IN')}</dd>
          </div>
        ))}
      </dl>
    )}

    {hasCards && (
      <div class:list={['recap__cards', view.mostBorrowed && view.fullest && 'recap__cards--two']}>
        {view.mostBorrowed && (
          <div class="recap__card">
            <h3 class="recap__card-label">Most borrowed</h3>
            <ol class="recap__rank">
              {view.mostBorrowed.map((game) => (
                <li>
                  <span class="recap__rank-title">{game.title}</span>
                  <span class="recap__rank-count">{game.loans}×</span>
                  <span class="recap__rank-bar" style={`--share:${game.share.toFixed(3)}`} aria-hidden="true"></span>
                </li>
              ))}
            </ol>
          </div>
        )}
        {view.fullest && (
          <div class="recap__card">
            <h3 class="recap__card-label">Fullest session</h3>
            <p class="recap__fullest-title">{view.fullest.title}</p>
            <p class="recap__fullest-meta">
              {[view.fullest.when, view.fullest.host && `hosted by ${view.fullest.host}`, `${view.fullest.booked} players booked`]
                .filter(Boolean)
                .join(' · ')}
            </p>
          </div>
        )}
      </div>
    )}

    {view.credit && <p class="recap__credit">{view.credit}</p>}

    <div class="recap__cta-row">
      <a href={primary.href} class="btn btn-black">{primary.text}</a>
      {secondary.map((link) => <a href={link.href} class="recap__link">{link.text}</a>)}
    </div>
  </div>
</section>

<style>
  .recap {
    background: var(--color-yellow);
    border-top: 4px solid var(--color-ink);
    border-bottom: 4px solid var(--color-ink);
  }

  .recap__inner {
    padding: 32px 24px;
  }

  @media (min-width: 768px) {
    .recap__inner {
      padding: 48px 24px;
    }
  }

  .recap__eyebrow {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .recap__heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--color-ink);
    margin: 4px 0 0;
    text-wrap: balance;
  }

  .recap__sub {
    margin-top: 12px;
    font-size: 1rem;
    color: rgba(26, 26, 26, 0.8);
    max-width: 60ch;
  }

  @media (min-width: 768px) {
    .recap__sub {
      font-size: 1.125rem;
    }
  }

  .recap__stats {
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (min-width: 768px) {
    .recap__stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
  }

  .recap__stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    padding: 16px 18px 14px;
    background: var(--color-paper);
    border: var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .recap__stat dd {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .recap__stat dt {
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .recap__cards {
    margin-top: 16px;
    display: grid;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .recap__cards--two {
      grid-template-columns: 1.15fr 1fr;
      gap: 16px;
    }
  }

  .recap__card {
    padding: 16px 18px;
    background: var(--color-paper);
    border: var(--border);
    border-radius: var(--radius-md);
  }

  .recap__card-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .recap__rank {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .recap__rank li {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 10px;
    row-gap: 4px;
    font-size: 0.9375rem;
    line-height: 1.25;
  }

  .recap__rank-count {
    font-family: var(--font-heading);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .recap__rank-bar {
    grid-column: 1 / -1;
    height: 7px;
    width: calc(var(--share) * 100%);
    min-width: 12px;
    border: 1.5px solid var(--color-ink);
    border-radius: 4px;
    background: var(--color-orange);
  }

  .recap__fullest-title {
    margin-top: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .recap__fullest-meta {
    margin-top: 6px;
    font-size: 0.9375rem;
  }

  .recap__credit {
    margin-top: 16px;
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .recap__cta-row {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
  }

  .recap__link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .recap__link:hover {
    text-decoration-thickness: 2px;
  }
</style>
