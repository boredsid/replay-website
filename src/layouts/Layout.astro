---
import '../styles/global.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description = "REPLAY is Bangalore's two-day board-game convention: open play, demos, tournaments, and hundreds of games.", ogImage = '/link-preview.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://replaycon.in').toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://replaycon.in').toString()} />
    <meta property="og:image:alt" content="REPLAY — Bangalore's board-game convention" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://replaycon.in').toString()} />
    <link rel="icon" type="image/png" href="/replay-icon.png" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="sticky top-0 z-40" style="background: #1A1A1A;">
      <div class="container-x px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
        <a href="/" aria-label="REPLAY home" class="inline-flex items-center">
          <img src="/replay-logo.png" alt="REPLAY" class="h-7 sm:h-9 md:h-10 w-auto max-w-[108px] sm:max-w-none" />
        </a>
        <nav aria-label="Main navigation" class="flex gap-3 sm:gap-6 md:gap-8 items-center">
          <a href="/schedule" class:list={['nav-link', path === '/schedule' && 'active']} aria-current={path === '/schedule' ? 'page' : undefined}>Schedule</a>
          <a href="/register" class="btn btn-primary btn-sm" aria-current={path === '/register' ? 'page' : undefined}>Register</a>
        </nav>
      </div>
    </header>

    <style>
      .nav-link {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 0.95rem;
        color: #FFFFFF;
        text-decoration: none;
        position: relative;
        padding: 4px 0;
        transition: color 0.2s;
      }
      .nav-link::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 3px;
        background: var(--color-orange);
        transition: width 0.25s;
      }
      .nav-link:hover {
        color: var(--color-orange);
      }
      .nav-link:hover::after,
      .nav-link.active::after {
        width: 100%;
      }
    </style>

    <main id="main-content" class="min-h-[60vh]" tabindex="-1">
      <slot />
    </main>

    <footer class="border-t-4 border-[var(--color-ink)] bg-[var(--color-paper)]">
      <div class="container-x px-6 py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm">
        <a href="mailto:hello@replaycon.in" class="hover:underline font-medium">hello@replaycon.in</a>
        <a href="https://www.instagram.com/replay.convention" target="_blank" rel="noopener" aria-label="REPLAY on Instagram" class="inline-flex items-center gap-2 hover:text-[var(--color-orange)]">
          <img src="/instagram.svg" alt="" width="20" height="20" />
          <span>@replay.convention</span>
        </a>
        <p class="text-gray-600">&copy; REPLAY · Bangalore</p>
      </div>
    </footer>
  </body>
</html>
