---
import '../styles/global.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Keeps a page out of search results — for pages only reachable by a link we send. */
  noindex?: boolean;
}

/**
 * Drawn at build time by `src/pages/link-preview.png.ts` from the current
 * edition row, so the card's dates and venue follow the site instead of being
 * re-exported by hand each edition. Its dimensions are fixed at 1200x630.
 */
const DEFAULT_OG_IMAGE = '/link-preview.png';

const {
  title,
  description = "REPLAY is Bangalore's board-game convention: a weekend of open play, community-run events, and a library of 200+ games.",
  ogImage = DEFAULT_OG_IMAGE,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://replaycon.in').toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/schedule', label: 'Schedule' },
  { href: '/plan-your-visit', label: 'Plan your visit' },
  { href: '/get-involved', label: 'Get involved' },
  { href: '/contact', label: 'Contact us' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? 'https://replaycon.in').toString()} />
    {ogImage === DEFAULT_OG_IMAGE && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content="REPLAY — Bangalore's board-game convention" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? 'https://replaycon.in').toString()} />
    <link rel="icon" type="image/png" href="/replay-icon.png" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="container-x site-header__inner">
        <a href="/" aria-label="REPLAY home" class="site-logo">
          <img src="/replay-logo.png" alt="REPLAY" />
        </a>

        <nav aria-label="Main navigation" class="desktop-nav">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={['nav-link', isActive(item.href) && 'active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <a href="/tickets" class="btn btn-primary btn-sm" aria-current={path === '/tickets' ? 'page' : undefined}>
            Tickets
          </a>
        </nav>

        <details class="mobile-menu">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation" class="mobile-menu__panel">
            {nav.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
            <a href="/tickets" class="mobile-menu__tickets" aria-current={path === '/tickets' ? 'page' : undefined}>Tickets</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" class="min-h-[60vh]" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container-x site-footer__inner">
        <div>
          <img src="/replay-logo.png" alt="REPLAY" class="site-footer__logo" />
          <p class="site-footer__tagline">Bangalore&apos;s weekend at the table.</p>
        </div>

        <nav aria-label="Footer navigation" class="site-footer__links">
          <a href="/tickets">Tickets</a>
          <a href="/schedule">Schedule</a>
          <a href="/plan-your-visit">Plan your visit</a>
          <a href="/get-involved">Get involved</a>
          <a href="/contact">Contact us</a>
        </nav>

        <div class="site-footer__contact">
          <a href="mailto:hello@replaycon.in">hello@replaycon.in</a>
          <a href="https://www.instagram.com/replay.convention" target="_blank" rel="noopener noreferrer" aria-label="REPLAY on Instagram">
            @replay.convention
          </a>
          <p>&copy; REPLAY · Bangalore</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-ink);
    border-bottom: 3px solid var(--color-ink);
  }

  .site-header__inner {
    min-height: 68px;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .site-logo img {
    display: block;
    width: auto;
    height: 38px;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 22px;
  }

  .nav-link {
    position: relative;
    padding: 8px 0;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 3px;
    background: var(--color-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    cursor: pointer;
    list-style: none;
    border: 2px solid #fff;
    border-radius: var(--radius-sm);
    color: #fff;
    padding: 7px 12px;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .mobile-menu summary::-webkit-details-marker { display: none; }

  .mobile-menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(82vw, 280px);
    display: grid;
    padding: 10px;
    border: 3px solid var(--color-ink);
    border-radius: var(--radius-md);
    background: var(--color-cream);
    box-shadow: var(--shadow-md);
  }

  .mobile-menu__panel a {
    padding: 12px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
  }

  .mobile-menu__panel a:hover,
  .mobile-menu__panel a[aria-current='page'] {
    background: var(--color-yellow);
  }

  .mobile-menu__panel a.mobile-menu__tickets {
    margin-top: 6px;
    background: var(--color-orange);
    color: #fff;
    border: 2px solid var(--color-ink);
    text-align: center;
  }

  .mobile-menu__panel a.mobile-menu__tickets:hover,
  .mobile-menu__panel a.mobile-menu__tickets[aria-current='page'] {
    background: var(--color-orange-dark);
    color: #fff;
  }

  .site-footer {
    background: var(--color-ink);
    color: #fff;
    border-top: 4px solid var(--color-ink);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 48px 24px;
  }

  .site-footer__logo { width: auto; height: 42px; }
  .site-footer__tagline { margin-top: 12px; color: rgba(255,255,255,.7); }

  .site-footer__links,
  .site-footer__contact {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .site-footer a { color: #fff; text-decoration-color: var(--color-orange); text-underline-offset: 3px; }
  .site-footer__contact p { color: rgba(255,255,255,.65); }

  @media (min-width: 920px) {
    .desktop-nav { display: flex; }
    .mobile-menu { display: none; }
  }

  @media (min-width: 720px) {
    .site-footer__inner { grid-template-columns: 1.2fr 1fr 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after { transition: none; }
  }
</style>
