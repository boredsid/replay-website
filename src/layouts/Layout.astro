---
import { Image } from 'astro:assets';
import '../styles/global.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import { headerLockup } from '../lib/header-lockup';
import { partnerLogos, type PartnerLogo } from '../lib/partner-logos';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Keeps a page out of search results — for pages only reachable by a link we send. */
  noindex?: boolean;
}

/**
 * Drawn at build time by `src/pages/link-preview.png.ts` from the current
 * edition row, so the card's dates and venue follow the site instead of being
 * re-exported by hand each edition. Its dimensions are fixed at 1200x630.
 */
const DEFAULT_OG_IMAGE = '/link-preview.png';

const {
  title,
  description = "REPLAY is Bangalore's board-game convention: a weekend of open play, community-run events, and a library of 200+ games.",
  ogImage = DEFAULT_OG_IMAGE,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://replaycon.in').toString();

/**
 * The card is redrawn every build but keeps its path, and `_headers` caches
 * `/*.png` for a week — so the URL has to change or the previous edition's
 * card keeps being served from caches we do not control. The stamp is set in
 * `astro.config.mjs`; see the note there for why it is not the commit SHA.
 */
const linkPreviewVersion = import.meta.env.PUBLIC_LINK_PREVIEW_VERSION;
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://replaycon.in');
if (ogImage === DEFAULT_OG_IMAGE && linkPreviewVersion) {
  ogImageUrl.searchParams.set('v', linkPreviewVersion);
}
const ogImageHref = ogImageUrl.toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/schedule', label: 'Schedule' },
  { href: '/plan-your-visit', label: 'Plan your visit' },
  { href: '/get-involved', label: 'Get involved' },
  { href: '/contact', label: 'Contact us' },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

/**
 * “X presents REPLAY in association with Y”, built from whoever holds those
 * two tiers this edition. Neither sold, and the header is the wordmark alone.
 */
const lockup = headerLockup(partnerLogos);

/**
 * A tile is the mark centred on a padded 3:2 canvas — right for the wall's
 * grid, too airy for a header block. These custom properties let the header
 * show the tile through a window the size of the mark itself: the window takes
 * the mark's aspect ratio, and the tile is blown up by however much padding
 * sits around the mark, so what lands on screen is the mark edge to edge.
 *
 * The window's width is stated as height x ratio rather than left to
 * `aspect-ratio`, which does not transfer to width on a flex item whose only
 * child is out of flow. `--mark-inv` is that ratio inverted, which is what
 * lets the window obey a width cap without cropping: a wide wordmark hits the
 * cap and takes the height the cap implies, while a squarer mark runs to the
 * block's full height.
 */
const markWindow = (logo: PartnerLogo) => [
  `--mark-num:${(logo.mark.width / logo.mark.height).toFixed(4)}`,
  `--mark-inv:${(logo.mark.height / logo.mark.width).toFixed(4)}`,
  `--tile-scale:${(logo.image.height / logo.mark.height).toFixed(4)}`,
].join(';');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageHref} />
    {ogImage === DEFAULT_OG_IMAGE && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content="REPLAY — Bangalore's board-game convention" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />
    <link rel="icon" type="image/png" href="/replay-icon.png" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      {lockup.hasCredits && (
        /*
         * The white ground each sponsor mark sits on, as a filter rather than
         * a rectangle behind it: grow the mark's own alpha outwards by the
         * halo's width, fill what that covers with white, and lay the mark
         * back down on top. `feMorphology` is a true dilation — every point
         * within the radius of an opaque pixel turns opaque — so the ground
         * follows the mark's outline however thin the strokes get.
         *
         * The radius is in the referring element's CSS pixels and cannot be
         * read from a custom property, so `--halo` below has to be kept equal
         * to it by hand. That is also why it is a fixed width rather than a
         * fraction of the wordmark: 3px reads as a ground at both sizes the
         * header puts a mark at, thicker against the smaller one.
         */
        <svg class="site-logo__halo-def" aria-hidden="true" focusable="false">
          <filter id="mark-halo" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
            <feMorphology in="SourceAlpha" operator="dilate" radius="3" result="grown" />
            <feFlood flood-color="#fff" result="white" />
            <feComposite in="white" in2="grown" operator="in" result="halo" />
            <feMerge>
              <feMergeNode in="halo" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </svg>
      )}

      <div class="container-x site-header__inner">
        <a
          href="/"
          class:list={[
            'site-logo',
            lockup.hasCredits && 'site-logo--lockup',
            lockup.presenter && lockup.associate && 'site-logo--two-credits',
          ]}
          aria-label={lockup.hasCredits ? undefined : 'REPLAY home'}
        >
          {lockup.presenter && (
            <span class="site-logo__block" style={markWindow(lockup.presenter)}>
              <span class="site-logo__mark">
                <Image
                  src={lockup.presenter.image}
                  alt={lockup.presenter.name}
                  width={480}
                  format="webp"
                  quality={82}
                  loading="eager"
                  class="site-logo__tile"
                />
              </span>
            </span>
          )}

          <span class="site-logo__stack">
            {lockup.presenter && <span class="site-logo__word site-logo__word--top">presents</span>}
            <img src="/replay-logo.png" alt="REPLAY" class="site-logo__wordmark" />
            {lockup.associate && <span class="site-logo__word site-logo__word--bottom">in association with</span>}
          </span>

          {lockup.associate && (
            <span class="site-logo__block" style={markWindow(lockup.associate)}>
              <span class="site-logo__mark">
                <Image
                  src={lockup.associate.image}
                  alt={lockup.associate.name}
                  width={480}
                  format="webp"
                  quality={82}
                  loading="eager"
                  class="site-logo__tile"
                />
              </span>
            </span>
          )}
        </a>

        <nav aria-label="Main navigation" class="desktop-nav">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={['nav-link', isActive(item.href) && 'active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <a href="/tickets" class="btn btn-primary btn-sm" aria-current={path === '/tickets' ? 'page' : undefined}>
            Tickets
          </a>
        </nav>

        <details class="mobile-menu">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation" class="mobile-menu__panel">
            {nav.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
            <a href="/tickets" class="mobile-menu__tickets" aria-current={path === '/tickets' ? 'page' : undefined}>Tickets</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" class="min-h-[60vh]" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container-x site-footer__inner">
        <div>
          <img src="/replay-logo.png" alt="REPLAY" class="site-footer__logo" />
          <p class="site-footer__tagline">Bangalore&apos;s weekend at the table.</p>
        </div>

        <nav aria-label="Footer navigation" class="site-footer__links">
          <a href="/tickets">Tickets</a>
          <a href="/schedule">Schedule</a>
          <a href="/library">Game library</a>
          <a href="/plan-your-visit">Plan your visit</a>
          <a href="/get-involved">Get involved</a>
          <a href="/contact">Contact us</a>
        </nav>

        <div class="site-footer__contact">
          <a href="mailto:hello@replaycon.in">hello@replaycon.in</a>
          <a href="https://www.instagram.com/replay.convention" target="_blank" rel="noopener noreferrer" aria-label="REPLAY on Instagram">
            @replay.convention
          </a>
          <p>&copy; REPLAY · Bangalore</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-ink);
    border-bottom: 3px solid var(--color-ink);
  }

  .site-header__inner {
    min-height: 68px;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  /*
   * `flex: 0 0 auto` and `max-width: none` are what hold the 38px: as a
   * shrinkable flex item the wordmark loses width to the global `max-width:
   * 100%`, and its aspect ratio then drags the height down with it.
   */
  .site-logo__wordmark {
    display: block;
    flex: 0 0 auto;
    width: auto;
    max-width: none;
    height: 38px;
  }

  /*
   * Billing lockup: the sponsor blocks flank the wordmark at the full height
   * of the credit stack, and the words tuck into the space the wordmark does
   * not use — “presents” above its left, “in association with” below its
   * right. The wordmark itself never changes size.
   */
  .site-logo--lockup {
    --wordmark-h: 38px;
    --word-size: 0.82rem;
    --stack-gap: 3px;
    /*
     * The height of the whole lockup, which the sponsor blocks are cut to. It
     * is stated rather than measured because a percentage height inside a
     * stretched flex item has nothing definite to resolve against — the blocks
     * collapse to nothing. Words are line-height 1, so one is exactly
     * `--word-size` tall.
     */
    --stack-h: calc(var(--wordmark-h) + var(--stack-gap) + var(--word-size));
    /*
     * The mark is a fixed fraction of the wordmark's height, never a size of
     * its own: a guest credit should read as the smaller of the two, and a
     * mark with its own height drifts past the wordmark the moment one of the
     * narrow bands below changes the wordmark's size. At 0.85 the mark also
     * stays inside the credit stack, so it costs the header no height, and it
     * goes short of 2.9:1 rather than running the width of the bar.
     */
    --mark-scale: 0.85;
    --mark-box: calc(var(--wordmark-h) * var(--mark-scale));
    --mark-max-ratio: 2.9;
    flex: 0 1 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }

  .site-logo--two-credits {
    --stack-h: calc(var(--wordmark-h) + 2 * var(--stack-gap) + 2 * var(--word-size));
  }

  .site-logo--lockup .site-logo__wordmark {
    height: var(--wordmark-h);
  }

  .site-logo__stack {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: var(--stack-gap);
  }

  .site-logo__word {
    color: rgba(255, 255, 255, 0.82);
    /* Space Grotesk, the same face and weight as the nav links beside it. */
    font-family: var(--font-heading);
    font-size: var(--word-size);
    font-weight: 650;
    line-height: 1;
    white-space: nowrap;
  }

  .site-logo__word--top { align-self: flex-start; }
  .site-logo__word--bottom { align-self: flex-end; }

  /*
   * The tiles are the wall's, drawn to sit on white, so on the ink header each
   * mark needs a white ground of its own — cut to the mark's shape rather than
   * laid down as a rectangle behind it. The tiles carry transparency around
   * the mark, which is what the `#mark-halo` filter grows outwards to make
   * that ground, so what sits behind the logo is its own outline rather than a
   * plate it stands on.
   *
   * A logo that reached the normaliser on a white matte has no transparency to
   * grow from — `logo-normalize` re-lays that matte across the whole tile — so
   * its ground comes out the rectangle it always was. That is the old plate,
   * not a failure: the mark still gets the white it was drawn for.
   */
  .site-logo__block {
    --mark-h: min(
      var(--mark-box),
      calc(var(--mark-box) * var(--mark-max-ratio) * var(--mark-inv))
    );
    --mark-w: calc(var(--mark-h) * var(--mark-num));
    /* Must equal the `#mark-halo` filter's radius; see the filter's note. */
    --halo: 3px;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    height: var(--mark-box);
  }

  /*
   * The window on to the mark — sized by the block above; see `markWindow`. It
   * reserves the halo's width on every side, so the ground has room to grow
   * without crowding the wordmark beside it.
   *
   * Nothing is clipped here: what surrounds the mark on the tile is
   * transparent, so letting it overflow shows nothing, and a mark whose tile
   * carries less padding than the halo is wide still gets a whole halo rather
   * than one with a shaved edge.
   */
  .site-logo__mark {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: calc(var(--mark-w) + 2 * var(--halo));
    height: calc(var(--mark-h) + 2 * var(--halo));
  }

  /* Defines `#mark-halo`; renders nothing itself. */
  .site-logo__halo-def {
    position: absolute;
    width: 0;
    height: 0;
  }

  .site-logo__tile {
    position: absolute;
    top: 50%;
    left: 50%;
    width: auto;
    max-width: none;
    /* Against the mark, not the window: the halo must not scale the mark. */
    height: calc(var(--mark-h) * var(--tile-scale));
    transform: translate(-50%, -50%);
    filter: url(#mark-halo);
  }

  .desktop-nav {
    display: none;
    flex: 0 0 auto;
    align-items: center;
    gap: 22px;
  }

  .nav-link {
    position: relative;
    padding: 8px 0;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 3px;
    background: var(--color-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .mobile-menu {
    position: relative;
    flex: 0 0 auto;
  }

  .mobile-menu summary {
    cursor: pointer;
    list-style: none;
    border: 2px solid #fff;
    border-radius: var(--radius-sm);
    color: #fff;
    padding: 7px 12px;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .mobile-menu summary::-webkit-details-marker { display: none; }

  .mobile-menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(82vw, 280px);
    display: grid;
    padding: 10px;
    border: 3px solid var(--color-ink);
    border-radius: var(--radius-md);
    background: var(--color-cream);
    box-shadow: var(--shadow-md);
  }

  .mobile-menu__panel a {
    padding: 12px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
  }

  .mobile-menu__panel a:hover,
  .mobile-menu__panel a[aria-current='page'] {
    background: var(--color-yellow);
  }

  .mobile-menu__panel a.mobile-menu__tickets {
    margin-top: 6px;
    background: var(--color-orange);
    color: #fff;
    border: 2px solid var(--color-ink);
    text-align: center;
  }

  .mobile-menu__panel a.mobile-menu__tickets:hover,
  .mobile-menu__panel a.mobile-menu__tickets[aria-current='page'] {
    background: var(--color-orange-dark);
    color: #fff;
  }

  .site-footer {
    background: var(--color-ink);
    color: #fff;
    border-top: 4px solid var(--color-ink);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 48px 24px;
  }

  .site-footer__logo { width: auto; height: 42px; }
  .site-footer__tagline { margin-top: 12px; color: rgba(255,255,255,.7); }

  .site-footer__links,
  .site-footer__contact {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .site-footer a { color: #fff; text-decoration-color: var(--color-orange); text-underline-offset: 3px; }
  .site-footer__contact p { color: rgba(255,255,255,.65); }

  @media (min-width: 920px) {
    .desktop-nav { display: flex; }
    .mobile-menu { display: none; }
  }

  /*
   * Phones. A 167px wordmark and a ~76px menu button leave about 70px of the
   * bar free, so a credit always takes its own line here — no arrangement of
   * sizes changes that. What this buys is height: a smaller credit line keeps
   * the sticky header from eating the screen.
   */
  /*
   * The two bands where the lockup cannot hold its full size, and the whole
   * thing is scaled down as a unit rather than wrapping: a block that wraps
   * onto its own line is as tall as the lockup, which turns a 90px header into
   * a 160px one. The wordmark only ever gives up height here, where the row is
   * genuinely too narrow to hold it — never merely because space is tight.
   */
  @media (min-width: 920px) and (max-width: 1009px) {
    .site-logo--two-credits {
      --wordmark-h: 30px;
      --word-size: 0.7rem;
    }
  }

  @media (max-width: 559px) {
    .site-logo--lockup {
      --word-size: 0.6rem;
      --mark-box: 22px;
      --stack-gap: 2px;
      gap: 6px 7px;
    }

    /* One credit still clears the menu button at full size; two do not. */
    .site-logo--two-credits {
      --wordmark-h: 26px;
      --mark-box: 22px;
    }
  }

  @media (max-width: 359px) {
    .site-logo--lockup { --wordmark-h: 26px; }
  }

  @media (min-width: 720px) {
    .site-footer__inner { grid-template-columns: 1.2fr 1fr 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after { transition: none; }
  }
</style>
