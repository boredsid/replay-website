---
import Layout from '../layouts/Layout.astro';
import DarkBand from '../components/DarkBand.astro';
import ScheduleDay from '../components/ScheduleDay.astro';
import { getCurrentEdition, getScheduleItems, editionOrdinal, publicDateRange } from '../lib/data';
import { clockTime, shortCalendarDate, weekdayName } from '../lib/edition-format';

const edition = await getCurrentEdition();
const items = edition ? await getScheduleItems(edition.id) : [];
const day1Items = edition ? items.filter((item) => item.day === edition.start_date) : [];
const day2Items = edition ? items.filter((item) => item.day === edition.end_date) : [];
const title = 'Schedule — REPLAY';
const ordinal = edition ? editionOrdinal(edition.slug) : '';
const range = edition ? publicDateRange(edition.start_date, edition.end_date) : '';
const day1Name = edition ? weekdayName(edition.start_date) : 'Day 1';
const day2Name = edition ? weekdayName(edition.end_date) : 'Day 2';
const hours = edition ? `${clockTime(edition.daily_start_time)}–${clockTime(edition.daily_end_time)}` : '';
---

<Layout title={title} description="Browse the REPLAY programme by day, time, activity type, and location.">
  <DarkBand
    eyebrow={edition ? `▸ ${ordinal.toUpperCase()}` : '▸ SCHEDULE'}
    eyebrowColor="var(--color-yellow)"
    heading="Make room for one more game."
    headingLevel="h1"
    body={edition ? `${range} · ${edition.venue}. Explore all-day activities, timed sessions, playtests, showcases and the event floor.` : 'No upcoming edition is published right now.'}
    cta={edition ? { text: 'Get tickets →', href: '/tickets', variant: 'primary' } : undefined}
  />

  {edition && (
    <section class="page-section page-section-yellow" aria-labelledby="schedule-essentials-heading">
      <div class="container-x">
        <span class="section-tag">At a glance</span>
        <h2 id="schedule-essentials-heading" class="section-heading">Your weekend, before the fine print.</h2>
        <div class="info-grid">
          <article class="info-card"><span class="info-card__kicker">When</span><h3>{range}</h3><p>{hours} each day</p></article>
          <article class="info-card"><span class="info-card__kicker">Where</span><h3>{edition.venue === 'TBD' ? 'Venue to be announced' : edition.venue}</h3><p><a href="/plan-your-visit" class="text-link">See arrival guidance →</a></p></article>
          <article class="info-card"><span class="info-card__kicker">Tickets</span><h3>Choose one day or both</h3><p><a href="/tickets" class="text-link">Compare tickets →</a></p></article>
        </div>
      </div>
    </section>
  )}

  <section class="page-section page-section-soft" aria-labelledby="programme-heading">
    <div class="container-x schedule-container">
      <span class="section-tag">Programme</span>
      <h2 id="programme-heading" class="section-heading">What&apos;s happening.</h2>

      {!edition ? (
        <div class="schedule-empty card-brutal">
          <h3>No upcoming schedule yet.</h3>
          <p>Follow REPLAY for the next edition announcement.</p>
        </div>
      ) : items.length === 0 ? (
        <div class="schedule-empty card-brutal">
          <span class="pill pill-purple">Coming soon</span>
          <h3>The detailed programme is being built.</h3>
          <p>All-day activities, timed sessions, playtests, publisher showcases, booths, food and event-floor information will appear here once confirmed.</p>
          <div class="button-row">
            <a href="/tickets" class="btn btn-primary">Get ticket updates →</a>
            <a href="/get-involved#run-an-event" class="btn btn-secondary">Propose an event →</a>
          </div>
        </div>
      ) : (
        /*
          Radio inputs rather than scripted tabs: the days switch with no
          JavaScript at all, arrow keys move between them for free, and both
          days stay in the HTML for search engines and for anyone reading the
          page without styles.
        */
        <div class="day-tabs">
          <fieldset class="day-tablist">
            <legend class="sr-only">Choose a day</legend>
            <label class="day-tab">
              <input class="sr-only" type="radio" name="schedule-day" value="day-1" checked />
              <span class="day-tab__name">{day1Name}</span>
              <span class="day-tab__date">{shortCalendarDate(edition.start_date)}</span>
            </label>
            <label class="day-tab">
              <input class="sr-only" type="radio" name="schedule-day" value="day-2" />
              <span class="day-tab__name">{day2Name}</span>
              <span class="day-tab__date">{shortCalendarDate(edition.end_date)}</span>
            </label>
          </fieldset>

          <div class="day-panel day-panel--1">
            <ScheduleDay date={edition.start_date} label={day1Name} items={day1Items} />
          </div>
          <div class="day-panel day-panel--2">
            <ScheduleDay date={edition.end_date} label={day2Name} items={day2Items} />
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="page-section page-section-blue" aria-labelledby="schedule-notes-heading">
    <div class="container-x">
      <span class="section-tag">Good to know</span>
      <h2 id="schedule-notes-heading" class="section-heading">Plan, but leave room to wander.</h2>
      <div class="info-grid">
        <article class="info-card"><h3>Programme changes</h3><p>Timings and rooms may move as the event approaches. Check this page again before travelling.</p></article>
        <article class="info-card"><h3>Joining an activity</h3><p>A convention ticket covers entry. Each listing will say whether you can walk in, need advance sign-up, or should register on site.</p></article>
        <article class="info-card"><h3>Need help choosing?</h3><p>Tell the team what you enjoy and how much time you have. We&apos;ll point you toward a table.</p><p><a class="text-link" href="/contact">Contact REPLAY →</a></p></article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .schedule-container { max-width: 960px; }
  .schedule-empty { margin-top: 32px; padding: clamp(28px, 6vw, 52px); }
  .schedule-empty h3 { margin-top: 18px; font-size: clamp(1.7rem, 4vw, 2.5rem); }
  .schedule-empty p { max-width: 62ch; margin-top: 12px; color: rgba(26,26,26,.72); }

  .day-tabs { margin-top: 32px; }
  .day-tablist {
    display: flex; flex-wrap: wrap; gap: 12px;
    margin: 0 0 2.5rem; padding: 0 0 1.6rem;
    border: 0; border-bottom: 4px solid var(--color-ink);
    min-width: 0;
  }
  .day-tab {
    display: grid; gap: 3px;
    padding: 12px 24px;
    border: 3px solid var(--color-ink); border-radius: var(--radius-md);
    background: var(--color-paper); color: var(--color-ink);
    box-shadow: var(--shadow-sm);
    cursor: pointer; user-select: none;
    transition: transform .12s ease, box-shadow .12s ease, background .12s ease, color .12s ease;
  }
  .day-tab__name { font-family: var(--font-heading); font-size: clamp(1.2rem, 3.4vw, 1.6rem); font-weight: 800; line-height: 1.05; letter-spacing: -.02em; }
  .day-tab__date { font-family: var(--font-heading); font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; opacity: .62; }
  .day-tab:hover { transform: translate(-2px, -2px); box-shadow: var(--shadow-md); }

  /* The selected day reads as pressed in: filled, flush, no shadow under it. */
  .day-tab:has(:checked) {
    background: var(--color-ink); color: var(--color-cream);
    transform: translate(2px, 2px); box-shadow: none;
  }
  .day-tab:has(:focus-visible) { outline: 3px solid var(--color-orange); outline-offset: 4px; }

  .day-panel { display: none; }
  .day-tabs:has(input[value="day-1"]:checked) .day-panel--1 { display: block; }
  .day-tabs:has(input[value="day-2"]:checked) .day-panel--2 { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .day-tab { transition: none; }
  }
</style>
