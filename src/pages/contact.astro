---
import Layout from '../layouts/Layout.astro';
import DarkBand from '../components/DarkBand.astro';
import { whatsappContactUrl } from '../lib/contact';
import { contactPage } from '../lib/contact-page';
import { getCurrentEdition, getSiteState } from '../lib/data';

const edition = await getCurrentEdition();
const site = await getSiteState();
// Between editions the ticket questions give way to the next edition's and the
// last one's; every phase-dependent sentence is decided in contact-page.ts.
const view = contactPage({ phase: site.phase, edition, recap: site.recap });
const faqs = view.faqs;
const contactWhatsapp = whatsappContactUrl('Hi, I have a question about REPLAY.');

const categories = [...new Set(faqs.map((item) => item.category))];
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
}).replace(/</g, '\\u003c');
---

<Layout title="Contact Us — REPLAY" description={view.description}>
  <script is:inline type="application/ld+json" set:html={faqJsonLd} />
  <DarkBand
    eyebrow="▸ CONTACT US"
    eyebrowColor="var(--color-yellow)"
    heading="Questions belong at the table too."
    headingLevel="h1"
    body={view.heroBody}
    cta={{ text: 'Contact us →', href: contactWhatsapp, variant: 'primary', external: true }}
    cta2={view.heroNotify ? { ...view.heroNotify, variant: 'outline-white' } : undefined}
  />

  <section class="page-section page-section-yellow" aria-labelledby="contact-options-heading">
    <div class="container-x">
      <span class="section-tag">Talk to us</span>
      <h2 id="contact-options-heading" class="section-heading">Use the route that fits.</h2>
      <div class="info-grid">
        <article class="info-card">
          <span class="info-card__kicker">{view.emailKicker}</span>
          <h3>Email REPLAY</h3>
          <p>{view.emailBody}</p>
          <p><a class="text-link" href="mailto:hello@replaycon.in">hello@replaycon.in →</a></p>
        </article>
        <article class="info-card">
          <span class="info-card__kicker">Announcements</span>
          <h3>Follow on Instagram</h3>
          <p>Dates, programme reveals and public updates.</p>
          <p><a class="text-link" href="https://www.instagram.com/replay.convention" target="_blank" rel="noopener noreferrer">@replay.convention ↗</a></p>
        </article>
        <article class="info-card">
          <span class="info-card__kicker">Community</span>
          <h3>Join the WhatsApp group</h3>
          <p>{view.communityBody}</p>
          <p><a class="text-link" href="https://chat.whatsapp.com/GL1h4jipksfCW4vm7OtZjp" target="_blank" rel="noopener noreferrer">Join the community ↗</a></p>
        </article>
        <article class="info-card">
          <span class="info-card__kicker">Partners</span>
          <h3>Get involved</h3>
          <p>{view.partnerBody}</p>
          <p><a class="text-link" href="/get-involved">See partnership routes →</a></p>
        </article>
      </div>
      {view.showHelpNotice && (
        <p class="notice contact-notice">The official same-day help number and ticket-desk escalation route have not been assigned yet. They will be added here and on Plan Your Visit before doors open.</p>
      )}
    </div>
  </section>

  <section class="page-section page-section-soft" aria-labelledby="questions-heading">
    <div class="container-x faq-container">
      <span class="section-tag">Common questions</span>
      <h2 id="questions-heading" class="section-heading">Answers before you ask.</h2>
      {categories.map((category) => (
        <section class="faq-group" aria-labelledby={`faq-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
          <h3 id={`faq-${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{category}</h3>
          <div class="faq-list">
            {faqs.filter((item) => item.category === category).map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="page-section page-section-purple">
    <div class="container-x two-column">
      <div>
        <span class="section-tag">Still stuck?</span>
        <h2 class="section-heading">Send the useful details.</h2>
        <p class="section-copy">{view.stuckCopy}</p>
      </div>
      <div class="button-row">
        <a class="btn btn-black" href="mailto:hello@replaycon.in?subject=REPLAY%20question">Email hello@replaycon.in</a>
        <a class="btn btn-secondary" href={view.stuckLink.href}>{view.stuckLink.text}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-notice { margin-top: 32px; }
  .faq-container { max-width: 900px; }
  .faq-group { margin-top: 48px; }
  .faq-group h3 { font-size: 1.6rem; }
</style>
