---
/**
 * REPLAY — Landing page
 * ---------------------------------------------------------------
 * Nine-section editorial arc, composed from shared bgc-style
 * components. Reads top to bottom as:
 *
 *   1. Dark hero slab          (DarkBand)
 *   2. Hero photo band         (HeroPhotoBand)
 *   3. Edition meta + spots    (inline, cream)
 *   4. 01 / THE EVENT          (EditorialStripe, yellow)
 *   5. 02 / 200+ GAMES         (EditorialStripe, blue)
 *   6. 03 / COMMUNITY          (EditorialStripe, purple)   #community
 *   7. Guild Path teaser       (DarkBand)
 *   8. Sponsors                (SponsorsBand, self-hides)
 *   9. Closing CTA finish      (inline, orange + photo backdrop)
 *
 * Only the orange finish is bespoke per-page; everything else is
 * composition. Keep it that way.
 */

import Layout from '../layouts/Layout.astro';
import DarkBand from '../components/DarkBand.astro';
import HeroPhotoBand from '../components/HeroPhotoBand.astro';
import EditorialStripe from '../components/EditorialStripe.astro';
import SponsorsBand from '../components/SponsorsBand.astro';
import LiveSpotsBadge from '../components/LiveSpotsBadge';
import { Image } from 'astro:assets';

import hero1 from '../assets/landing/hero-band-1.jpeg';
import hero2 from '../assets/landing/hero-band-2.jpeg';
import hero3 from '../assets/landing/hero-band-3.jpeg';
import stripeEvent from '../assets/landing/stripe-event.jpeg';
import stripeGames from '../assets/landing/stripe-games.jpeg';
import stripeCommunity from '../assets/landing/stripe-community.jpeg';
import closingPhoto from '../assets/landing/closing-cta.jpeg';

import { getCurrentEdition, getSponsors, editionOrdinal, shortDate, shortDateRange } from '../lib/data';

const edition = await getCurrentEdition();
const sponsors = edition ? await getSponsors(edition.id) : [];

const title = "REPLAY — Bangalore's gaming convention";

// Dark hero CTA — only when there's a live edition to point at. One CTA only.
const heroPrimaryCta = edition
  ? edition.registration_status === 'open'
    ? { text: 'Register now →', href: '/register', variant: 'primary' as const }
    : { text: 'Get notified →', href: '/register', variant: 'primary' as const }
  : undefined;

const editionOrdinalLabel = edition ? editionOrdinal(edition.slug) : '';
const dateRange = edition ? shortDateRange(edition.start_date, edition.end_date) : '';

const closingVenueTail =
  edition && edition.venue && edition.venue !== 'TBD' ? ` · ${edition.venue}` : '';
---

<Layout title={title}>
  {/* ──────────────────────────────────────────────────────────── 1. Dark hero */}
  <DarkBand
    bg="#FFF8E7"
    tone="light"
    heading="A weekend to switch off."
    body="Two days. Hundreds of players. 200+ games. Everyone welcome."
    cta={heroPrimaryCta}
  />

  {/* ──────────────────────────────────────────────────────────── 2. Photo band */}
  <HeroPhotoBand photos={[hero1, hero2, hero3]} />

  {/* ──────────────────────────────────────────────────────────── 3. Event capacity (bgc-style yellow band) */}
  {edition && (
    <section class="event-capacity">
      <div class="container-x event-capacity__inner">
        <div class="event-capacity__eyebrow">▸ {editionOrdinalLabel.toUpperCase()}</div>
        <h2 class="event-capacity__heading">{dateRange}</h2>
        <p class="event-capacity__sub">Bangalore · {edition.venue}</p>
        <div class="event-capacity__bar">
          <LiveSpotsBadge client:load editionId={edition.id} />
        </div>
        <div class="event-capacity__cta-row">
          <a href="/register" class="btn btn-black">
            {edition.registration_status === 'open' ? 'Register →' : 'Get notified →'}
          </a>
          <a href="/schedule" class="event-capacity__link">or see the schedule →</a>
        </div>
      </div>
    </section>
  )}

  {/* ──────────────────────────────────────────────────────────── 4. 01 / EVENT */}
  <EditorialStripe
    number="01"
    label="THE EVENT"
    heading="Two days. One library. Hundreds of games in motion."
    body="Show up Saturday, leave Sunday with three new friends and a list of games you want to buy. Demos, tournaments, open play — all day, both days."
    ctaText="See the schedule →"
    ctaHref="/schedule"
    bgColor="#FFD166"
    photo={stripeEvent}
    photoAlt="REPLAY event floor"
    photoSide="left"
  />

  {/* ──────────────────────────────────────────────────────────── 5. 02 / GAMES */}
  <EditorialStripe
    number="02"
    label="200+ GAMES"
    heading="From 10-minute fillers to 4-hour epics."
    body="Bring your favorite. Borrow ours. Try something you've never heard of. Publishers and designers are on the floor doing demos all weekend."
    ctaText="What to expect →"
    ctaHref="/schedule"
    bgColor="#4ECDC4"
    photo={stripeGames}
    photoAlt="Games at REPLAY"
    photoSide="right"
  />

  {/* ──────────────────────────────────────────────────────────── 6. 03 / COMMUNITY */}
  <div id="community">
    <EditorialStripe
      number="03"
      label="COMMUNITY"
      heading="The best of Bangalore, all in one room."
      body="New faces every edition. No prior experience needed — pick a game, find a table, ask the room."
      ctaText="Join the WhatsApp →"
      ctaHref="https://chat.whatsapp.com/GL1h4jipksfCW4vm7OtZjp"
      ctaExternal
      bgColor="#C3A6FF"
      photo={stripeCommunity}
      photoAlt="REPLAY community"
      photoSide="left"
    />
  </div>

  {/* ──────────────────────────────────────────────────────────── 7. Guild Path */}
  <DarkBand
    eyebrow="▸ FOR REGULARS"
    eyebrowColor="var(--color-yellow)"
    heading="Get heavy discounts as a Guild Path member."
    body="If you're on the BGC Guild Path, your tier carries to REPLAY. Adventurers get up to ₹1,000 off. Guildmasters: free pass."
    cta={{
      text: 'About Guild Path →',
      href: 'https://boardgamecompany.in/guild-path',
      external: true,
      variant: 'primary',
    }}
  />

  {/* ──────────────────────────────────────────────────────────── 8. Sponsors */}
  <SponsorsBand sponsors={sponsors} />

  {/* ──────────────────────────────────────────────────────────── 9. Orange CTA finish */}
  {edition && (
    <section class="closing-cta" aria-labelledby="closing-cta-heading">
      <Image
        src={closingPhoto}
        alt=""
        widths={[800, 1600]}
        sizes="100vw"
        loading="lazy"
        class="closing-cta__bg"
      />

      <span class="closing-cta__monogram" aria-hidden="true">R/</span>

      <div class="container-x closing-cta__inner">
        <span class="closing-cta__eyebrow">
          <span class="closing-cta__dot" aria-hidden="true"></span>
          SAVE THE DATE
        </span>

        <h2 id="closing-cta-heading" class="closing-cta__heading">
          See you in September.
        </h2>

        <p class="closing-cta__meta">
          <strong>{editionOrdinalLabel}</strong>
          <span class="closing-cta__bullet" aria-hidden="true">·</span>
          {dateRange}{closingVenueTail}
        </p>

        <div class="closing-cta__row">
          <a href="/register" class="btn btn-black">Register →</a>
          <a href="/schedule" class="closing-cta__link">
            Browse the schedule
            <span aria-hidden="true" class="closing-cta__link-arrow">↗</span>
          </a>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  /* ───────────────────────────── Event capacity band (bgc-style) ───────────────────────────── */
  .event-capacity {
    background: var(--color-yellow);
    border-top: 4px solid var(--color-ink);
    border-bottom: 4px solid var(--color-ink);
  }

  .event-capacity__inner {
    padding: 32px 24px;
  }

  @media (min-width: 768px) {
    .event-capacity__inner {
      padding: 48px 24px;
    }
  }

  .event-capacity__eyebrow {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .event-capacity__eyebrow {
      font-size: 1rem;
    }
  }

  .event-capacity__heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--color-ink);
    margin: 4px 0 0;
  }

  .event-capacity__sub {
    margin-top: 12px;
    font-size: 1rem;
    color: rgba(26, 26, 26, 0.8);
  }

  @media (min-width: 768px) {
    .event-capacity__sub {
      font-size: 1.125rem;
    }
  }

  .event-capacity__bar {
    margin-top: 20px;
  }

  .event-capacity__cta-row {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .event-capacity__link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .event-capacity__link:hover {
    text-decoration-thickness: 2px;
  }

  /* ───────────────────────────── Closing CTA ───────────────────────────── */
  .closing-cta {
    position: relative;
    background: var(--color-orange);
    overflow: hidden;
    border-top: 4px solid var(--color-ink);
    isolation: isolate;
  }

  .closing-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
    filter: contrast(1.05) saturate(0.9);
    z-index: 0;
  }

  /* Decorative oversized monogram bleeding off the right edge. */
  .closing-cta__monogram {
    position: absolute;
    right: -3vw;
    bottom: -2vw;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(12rem, 28vw, 24rem);
    line-height: 0.85;
    color: rgba(255, 255, 255, 0.12);
    letter-spacing: -0.06em;
    pointer-events: none;
    z-index: 1;
    user-select: none;
  }

  .closing-cta__inner {
    position: relative;
    z-index: 2;
    padding: 88px 24px 96px;
  }

  @media (min-width: 768px) {
    .closing-cta__inner {
      padding: 128px 24px 144px;
    }
  }

  .closing-cta__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.92);
    padding: 6px 14px;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    margin-bottom: 28px;
  }

  .closing-cta__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-ink);
    display: inline-block;
  }

  .closing-cta__heading {
    font-family: var(--font-heading);
    font-weight: 700;
    color: #ffffff;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -2px;
    margin: 0;
    max-width: 16ch;
    text-shadow: 0 2px 0 rgba(26, 26, 26, 0.18);
  }

  .closing-cta__meta {
    margin-top: 24px;
    max-width: 36rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
  }

  .closing-cta__meta strong {
    color: #ffffff;
    font-weight: 700;
  }

  .closing-cta__bullet {
    color: rgba(255, 255, 255, 0.55);
  }

  .closing-cta__row {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .closing-cta__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 2px solid rgba(255, 255, 255, 0.6);
    padding-bottom: 2px;
    transition: border-color 0.15s, transform 0.15s;
  }

  .closing-cta__link:hover {
    border-bottom-color: #ffffff;
    transform: translateY(-1px);
  }

  .closing-cta__link-arrow {
    font-size: 1.05em;
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .closing-cta__link {
      transition: none;
    }
    .closing-cta__link:hover {
      transform: none;
    }
    .edition-meta__tag {
      transform: none;
    }
  }
</style>
