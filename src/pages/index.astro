---
/**
 * REPLAY — Landing page
 * ---------------------------------------------------------------
 * Nine-section editorial arc, composed from shared bgc-style
 * components. Reads top to bottom as:
 *
 *   1. Dark hero slab          (DarkBand)
 *   2. Hero photo band         (HeroPhotoBand)
 *   3. Edition meta + spots    (inline, cream)
 *   4. 01 / THE EVENT          (EditorialStripe, yellow)
 *   5. 02 / 200+ GAMES         (EditorialStripe, blue)
 *   6. 03 / COMMUNITY          (EditorialStripe, purple)   #community
 *   7. Guild Path teaser       (DarkBand)
 *   8. Sponsors                (SponsorsBand, self-hides)
 *   9. Closing CTA finish      (inline, orange + photo backdrop)
 *
 * Only the orange finish is bespoke per-page; everything else is
 * composition. Keep it that way.
 */

import Layout from '../layouts/Layout.astro';
import DarkBand from '../components/DarkBand.astro';
import HeroPhotoBand from '../components/HeroPhotoBand.astro';
import EditorialStripe from '../components/EditorialStripe.astro';
import SponsorsBand from '../components/SponsorsBand.astro';
import LiveSpotsBadge from '../components/LiveSpotsBadge';
import { Image } from 'astro:assets';

import hero1 from '../assets/landing/hero-band-1.jpeg';
import hero2 from '../assets/landing/hero-band-2.jpeg';
import hero3 from '../assets/landing/hero-band-3.jpeg';
import stripeEvent from '../assets/landing/stripe-event.jpeg';
import stripeGames from '../assets/landing/stripe-games.jpeg';
import stripeCommunity from '../assets/landing/stripe-community.jpeg';
import closingPhoto from '../assets/landing/closing-cta.jpeg';

import { getCurrentEdition, getSponsors, editionOrdinal, publicDateRange } from '../lib/data';
import { clockTime, weekdayName } from '../lib/edition-format';

const edition = await getCurrentEdition();
const sponsors = edition ? await getSponsors(edition.id) : [];

const title = "REPLAY — Bangalore's gaming convention";

// Dark hero CTA — only when there's a live edition to point at. One CTA only.
const heroPrimaryCta = edition
  ? edition.registration_status === 'open'
    ? { text: 'Get tickets →', href: '/tickets', variant: 'primary' as const }
    : { text: 'Get ticket updates →', href: '/tickets', variant: 'primary' as const }
  : undefined;

const editionOrdinalLabel = edition ? editionOrdinal(edition.slug) : '';
const dateRange = edition ? publicDateRange(edition.start_date, edition.end_date) : '';
const day1Name = edition ? weekdayName(edition.start_date) : 'Day 1';
const day2Name = edition ? weekdayName(edition.end_date) : 'Day 2';
const dailyHours = edition ? `${clockTime(edition.daily_start_time)}–${clockTime(edition.daily_end_time)}` : '';

const closingVenueTail =
  edition && edition.venue && edition.venue !== 'TBD' ? ` · ${edition.venue}` : '';
const eventJsonLd = edition ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${edition.name} ${editionOrdinalLabel}`.trim(),
  description: "Bangalore's board-game convention with open play, community-run events, and a library of 200+ games.",
  startDate: edition.start_date,
  endDate: edition.end_date,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: edition.venue === 'TBD' ? 'Bangalore — venue to be announced' : edition.venue,
    address: { '@type': 'PostalAddress', addressLocality: 'Bangalore', addressCountry: 'IN' },
  },
  organizer: { '@type': 'Organization', name: 'REPLAY', url: 'https://replaycon.in' },
  image: ['https://replaycon.in/link-preview.png'],
  offers: {
    '@type': 'Offer',
    url: 'https://replaycon.in/tickets/',
    priceCurrency: 'INR',
    price: Math.min(edition.pricing.oneshot.day1, edition.pricing.oneshot.day2),
    availability: edition.registration_status === 'sold_out'
      ? 'https://schema.org/SoldOut'
      : edition.registration_status === 'open'
        ? 'https://schema.org/InStock'
        : 'https://schema.org/PreOrder',
  },
}).replace(/</g, '\\u003c') : null;
---

<Layout title={title} description="REPLAY is Bangalore's board-game convention: open play, community-run events, and a library of 200+ games.">
  {eventJsonLd && <script is:inline type="application/ld+json" set:html={eventJsonLd} />}
  {/* ──────────────────────────────────────────────────────────── 1. Dark hero */}
  <DarkBand
    bg="#FFF8E7"
    tone="light"
    heading="A weekend to switch off."
    headingLevel="h1"
    body="Two days. One shared library of 200+ games. Beginners, regulars, and everyone in between welcome."
    cta={heroPrimaryCta}
  />

  {/* ──────────────────────────────────────────────────────────── 2. Photo band */}
  <HeroPhotoBand photos={[hero1, hero2, hero3]} />

  {/* ──────────────────────────────────────────────────────────── 3. Event capacity (bgc-style yellow band) */}
  {edition && (
    <section class="event-capacity">
      <div class="container-x event-capacity__inner">
        <div class="event-capacity__eyebrow">▸ {editionOrdinalLabel.toUpperCase()}</div>
        <h2 class="event-capacity__heading">{dateRange}</h2>
        <p class="event-capacity__sub">Bangalore · {edition.venue === 'TBD' ? 'venue to be announced' : edition.venue} · {dailyHours} daily</p>
        <div class="event-capacity__bar">
          <LiveSpotsBadge client:load editionId={edition.id} day1Label={day1Name} day2Label={day2Name} />
        </div>
        <div class="event-capacity__cta-row">
          <a href="/tickets" class="btn btn-black">
            {edition.registration_status === 'open' ? 'Get tickets →' : 'Get ticket updates →'}
          </a>
          <a href="/schedule" class="event-capacity__link">or see the schedule →</a>
        </div>
      </div>
    </section>
  )}

  {/* ──────────────────────────────────────────────────────────── 4. 01 / EVENT */}
  <EditorialStripe
    number="01"
    label="THE EVENT"
    heading="Two days. One library. Hundreds of games in motion."
    body={`Come for ${day1Name}, ${day2Name}, or both. Find open play, hosted events, and plenty of room to learn something new.`}
    ctaText="See the schedule →"
    ctaHref="/schedule"
    bgColor="#FFD166"
    photo={stripeEvent}
    photoAlt="REPLAY event floor"
    photoSide="left"
  />

  {/* ──────────────────────────────────────────────────────────── 5. 02 / GAMES */}
  <EditorialStripe
    number="02"
    label="200+ GAMES"
    heading="From 10-minute fillers to 4-hour epics."
    body="Bring a favourite, borrow from the REPLAY library, or try something you've never heard of. The collection runs from quick fillers to table-filling epics."
    ctaText="Plan your visit →"
    ctaHref="/plan-your-visit"
    bgColor="#4ECDC4"
    photo={stripeGames}
    photoAlt="Games at REPLAY"
    photoSide="right"
  />

  {/* ──────────────────────────────────────────────────────────── 6. 03 / COMMUNITY */}
  <div id="community">
    <EditorialStripe
      number="03"
      label="COMMUNITY"
      heading="The best of Bangalore, all in one room."
      body="New faces every edition. No prior experience needed — pick a game, find a table, ask the room."
      ctaText="Join the WhatsApp →"
      ctaHref="https://chat.whatsapp.com/GL1h4jipksfCW4vm7OtZjp"
      ctaExternal
      bgColor="#C3A6FF"
      photo={stripeCommunity}
      photoAlt="REPLAY community"
      photoSide="left"
    />
  </div>

  <section class="page-section page-section-paper" aria-labelledby="how-it-works-heading">
    <div class="container-x">
      <span class="section-tag">How the weekend works</span>
      <h2 id="how-it-works-heading" class="section-heading">No group? No rulebook? No problem.</h2>
      <p class="section-copy">REPLAY is designed to help you move from arriving to playing without already knowing the room.</p>
      <div class="info-grid">
        <article class="info-card"><span class="info-card__kicker">01</span><h3>Check in</h3><p>Use the phone number on your ticket. Keep the confirmation email available as a second reference.</p></article>
        <article class="info-card"><span class="info-card__kicker">02</span><h3>Choose your next game</h3><p>Follow the schedule, ask for a recommendation, or browse the shared library.</p></article>
        <article class="info-card"><span class="info-card__kicker">03</span><h3>Find a table</h3><p>Join a hosted activity or ask the team to help you find an open-play table at your pace.</p></article>
      </div>
    </div>
  </section>

  {edition && (
    <section class="home-actions" aria-labelledby="home-actions-heading">
      <div class="container-x home-actions__inner">
        <span class="section-tag">Make a plan</span>
        <h2 id="home-actions-heading" class="section-heading">Choose what you need next.</h2>
        <div class="home-actions__grid">
          <a href="/tickets" class="home-action-card home-action-card--orange"><span>Tickets</span><strong>Compare one-day and weekend options.</strong><em>Choose your ticket →</em></a>
          <a href="/schedule" class="home-action-card home-action-card--blue"><span>Schedule</span><strong>See what is happening and when.</strong><em>Browse the programme →</em></a>
          <a href="/plan-your-visit" class="home-action-card home-action-card--yellow"><span>Plan your visit</span><strong>Get the venue, arrival and access details.</strong><em>Prepare for the day →</em></a>
          <a href="/get-involved" class="home-action-card home-action-card--purple"><span>Partners</span><strong>Run an event, book a booth, sponsor or create.</strong><em>Get involved →</em></a>
        </div>
        <p class="home-actions__help">Still deciding? <a href="/contact">Read common answers or contact the team →</a></p>
      </div>
    </section>
  )}

  {/* ──────────────────────────────────────────────────────────── 7. Guild Path */}
  <DarkBand
    eyebrow="▸ FOR REGULARS"
    eyebrowColor="var(--color-yellow)"
    heading="Get heavy discounts as a Guild Path member."
    body={`If you're on the BGC Guild Path, your tier carries to REPLAY. Adventurers get up to ₹${edition?.pricing.adventurer_cap ?? 1000} off. Guildmasters receive a free eligible ticket.`}
    cta={{
      text: 'About Guild Path →',
      href: 'https://boardgamecompany.in/guild-path',
      external: true,
      variant: 'primary',
    }}
  />

  {/* ──────────────────────────────────────────────────────────── 8. Sponsors */}
  <SponsorsBand sponsors={sponsors} />

  {/* ──────────────────────────────────────────────────────────── 9. Orange CTA finish */}
  {edition && (
    <section class="closing-cta" aria-labelledby="closing-cta-heading">
      <Image
        src={closingPhoto}
        alt=""
        layout="constrained"
        width={1600}
        widths={[800, 1600]}
        sizes="100vw"
        format="avif"
        quality={55}
        loading="lazy"
        class="closing-cta__bg"
      />

      <span class="closing-cta__monogram" aria-hidden="true">R/</span>

      <div class="container-x closing-cta__inner">
        <span class="closing-cta__eyebrow">
          <span class="closing-cta__dot" aria-hidden="true"></span>
          SAVE THE DATE
        </span>

        <h2 id="closing-cta-heading" class="closing-cta__heading">
          See you at the table.
        </h2>

        <p class="closing-cta__meta">
          <strong>{editionOrdinalLabel}</strong>
          <span class="closing-cta__bullet" aria-hidden="true">·</span>
          {dateRange}{closingVenueTail}
        </p>

        <div class="closing-cta__row">
          <a href="/tickets" class="btn btn-black">Tickets →</a>
          <a href="/schedule" class="closing-cta__link">
            Browse the schedule
            <span aria-hidden="true" class="closing-cta__link-arrow">↗</span>
          </a>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  /* ───────────────────────────── Event capacity band (bgc-style) ───────────────────────────── */
  .event-capacity {
    background: var(--color-yellow);
    border-top: 4px solid var(--color-ink);
    border-bottom: 4px solid var(--color-ink);
  }

  .event-capacity__inner {
    padding: 32px 24px;
  }

  @media (min-width: 768px) {
    .event-capacity__inner {
      padding: 48px 24px;
    }
  }

  .event-capacity__eyebrow {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .event-capacity__eyebrow {
      font-size: 1rem;
    }
  }

  .event-capacity__heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--color-ink);
    margin: 4px 0 0;
  }

  .event-capacity__sub {
    margin-top: 12px;
    font-size: 1rem;
    color: rgba(26, 26, 26, 0.8);
  }

  @media (min-width: 768px) {
    .event-capacity__sub {
      font-size: 1.125rem;
    }
  }

  .event-capacity__bar {
    margin-top: 20px;
  }

  .event-capacity__cta-row {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .event-capacity__link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .event-capacity__link:hover {
    text-decoration-thickness: 2px;
  }

  /* ───────────────────────────── Homepage action grid ───────────────────────────── */
  .home-actions {
    background: var(--color-cream);
    border-top: 4px solid var(--color-ink);
    border-bottom: 4px solid var(--color-ink);
  }

  .home-actions__inner { padding: 72px 24px; }

  .home-actions__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 36px;
  }

  .home-action-card {
    display: flex;
    flex-direction: column;
    min-height: 240px;
    padding: 26px;
    border: 4px solid var(--color-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    color: var(--color-ink);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .home-action-card:hover { transform: translate(-3px, -3px); box-shadow: var(--shadow-lg); }
  .home-action-card--orange { background: var(--color-orange); }
  .home-action-card--blue { background: var(--color-blue); }
  .home-action-card--yellow { background: var(--color-yellow); }
  .home-action-card--purple { background: var(--color-purple); }
  .home-action-card span { font-family: var(--font-heading); font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .home-action-card strong { margin-top: 18px; max-width: 19ch; font-family: var(--font-heading); font-size: 1.5rem; line-height: 1.15; }
  .home-action-card em { margin-top: auto; padding-top: 26px; font-family: var(--font-heading); font-style: normal; font-weight: 750; text-decoration: underline; text-underline-offset: 4px; }
  .home-actions__help { margin-top: 28px; font-weight: 650; }
  .home-actions__help a { color: var(--color-ink); text-decoration-color: var(--color-orange); text-decoration-thickness: 2px; text-underline-offset: 4px; }

  @media (min-width: 720px) {
    .home-actions__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* ───────────────────────────── Closing CTA ───────────────────────────── */
  .closing-cta {
    position: relative;
    background: var(--color-orange);
    overflow: hidden;
    border-top: 4px solid var(--color-ink);
    isolation: isolate;
  }

  .closing-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
    filter: contrast(1.05) saturate(0.9);
    z-index: 0;
  }

  /* Decorative oversized monogram bleeding off the right edge. */
  .closing-cta__monogram {
    position: absolute;
    right: -3vw;
    bottom: -2vw;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(12rem, 28vw, 24rem);
    line-height: 0.85;
    color: rgba(255, 255, 255, 0.12);
    letter-spacing: -0.06em;
    pointer-events: none;
    z-index: 1;
    user-select: none;
  }

  .closing-cta__inner {
    position: relative;
    z-index: 2;
    padding: 88px 24px 96px;
  }

  @media (min-width: 768px) {
    .closing-cta__inner {
      padding: 128px 24px 144px;
    }
  }

  .closing-cta__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.92);
    padding: 6px 14px;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    margin-bottom: 28px;
  }

  .closing-cta__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-ink);
    display: inline-block;
  }

  .closing-cta__heading {
    font-family: var(--font-heading);
    font-weight: 700;
    color: #ffffff;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -2px;
    margin: 0;
    max-width: 16ch;
    text-shadow: 0 2px 0 rgba(26, 26, 26, 0.18);
  }

  .closing-cta__meta {
    margin-top: 24px;
    max-width: 36rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
  }

  .closing-cta__meta strong {
    color: #ffffff;
    font-weight: 700;
  }

  .closing-cta__bullet {
    color: rgba(255, 255, 255, 0.55);
  }

  .closing-cta__row {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .closing-cta__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 2px solid rgba(255, 255, 255, 0.6);
    padding-bottom: 2px;
    transition: border-color 0.15s, transform 0.15s;
  }

  .closing-cta__link:hover {
    border-bottom-color: #ffffff;
    transform: translateY(-1px);
  }

  .closing-cta__link-arrow {
    font-size: 1.05em;
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-action-card { transition: none; }
    .home-action-card:hover { transform: none; box-shadow: var(--shadow-md); }
    .closing-cta__link {
      transition: none;
    }
    .closing-cta__link:hover {
      transform: none;
    }
    .edition-meta__tag {
      transform: none;
    }
  }
</style>
