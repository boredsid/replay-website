---
import Layout from '../layouts/Layout.astro';
import DarkBand from '../components/DarkBand.astro';
import RegisterForm from '../components/RegisterForm';
import NotifyMeForm from '../components/NotifyMeForm';
import LiveSpotsBadge from '../components/LiveSpotsBadge';
import { getCurrentEdition, editionOrdinal, publicDateRange } from '../lib/data';
import { eventDayLabel, weekdayName } from '../lib/edition-format';

const edition = await getCurrentEdition();
const upiId = import.meta.env.PUBLIC_UPI_ID ?? '';
const title = 'Tickets — REPLAY';
const ordinal = edition ? editionOrdinal(edition.slug) : '';
const dateRange = edition ? publicDateRange(edition.start_date, edition.end_date) : '';
const day1Name = edition ? weekdayName(edition.start_date) : 'Day 1';
const day2Name = edition ? weekdayName(edition.end_date) : 'Day 2';
const day1Label = edition ? eventDayLabel(edition.start_date) : 'Day 1';
const day2Label = edition ? eventDayLabel(edition.end_date) : 'Day 2';
const statusCopy = edition?.registration_status === 'open'
  ? 'Choose a day ticket or make a full weekend of it.'
  : edition?.registration_status === 'sold_out'
    ? 'Tickets are currently sold out. Leave your number for any availability updates.'
    : edition?.registration_status === 'closed'
      ? 'Ticket sales for this edition are closed.'
      : 'Tickets are not open yet. Leave your number and the REPLAY team can contact you when they are.';
---

<Layout title={title} description="Compare REPLAY day and weekend tickets, see live availability, and register for the next edition.">
  <DarkBand
    eyebrow={edition ? `▸ ${ordinal.toUpperCase()}` : '▸ TICKETS'}
    eyebrowColor="var(--color-yellow)"
    heading="Pick your way to play."
    headingLevel="h1"
    body={edition ? `${dateRange} · ${edition.venue}. ${statusCopy}` : 'No upcoming edition is published right now.'}
    cta={edition ? { text: edition.registration_status === 'open' ? 'Choose tickets ↓' : 'Get updates ↓', href: '#ticket-action', variant: 'primary' } : undefined}
  />

  {edition && (
    <section class="page-section page-section-yellow" aria-labelledby="ticket-options-heading">
      <div class="container-x">
        <span class="section-tag">Ticket options</span>
        <h2 id="ticket-options-heading" class="section-heading">One day or the whole weekend.</h2>
        <p class="section-copy">Every ticket covers convention entry for the selected day, access to the shared game library while you are on site, and the public programme subject to individual activity capacity.</p>

        <div class="ticket-grid">
          <article class="ticket-card">
            <span class="pill pill-blue">One day</span>
            <h3>1-day pass</h3>
            <p class="ticket-price">₹{edition.pricing.oneshot}</p>
            <p class="ticket-price-note">Same price on either day</p>
            <ul class="clean-list">
              <li>Choose {day1Label} or {day2Label}</li>
              <li>Entry and programme access for your chosen day</li>
              <li>Borrow from the REPLAY game library while on site</li>
            </ul>
          </article>

          <article class="ticket-card ticket-card--featured">
            <span class="pill pill-accent">Both days</span>
            <h3>2-day pass</h3>
            <p class="ticket-price">₹{edition.pricing.campaign}</p>
            <p class="ticket-price-note">Both event days</p>
            <ul class="clean-list">
              <li>Entry on {day1Name} and {day2Name}</li>
              <li>The easiest way to explore more of the programme</li>
              <li>Borrow from the REPLAY game library while on site</li>
            </ul>
          </article>
        </div>

        <div class="availability-card">
          <h3>Live availability</h3>
          <p>Capacity is tracked separately for each event day.</p>
          <LiveSpotsBadge client:load editionId={edition.id} day1Label={day1Name} day2Label={day2Name} />
        </div>
      </div>
    </section>
  )}

  <section class="page-section page-section-paper" aria-labelledby="guild-heading">
    <div class="container-x two-column">
      <div>
        <span class="section-tag">Guild Path</span>
        <h2 id="guild-heading" class="section-heading">Your membership travels with you.</h2>
        <p class="section-copy">Enter the phone number attached to your active BGC Guild Path membership. The ticket form checks your tier automatically.</p>
      </div>
      <div class="info-grid guild-grid">
        <article class="info-card"><span class="info-card__kicker">Initiate</span><h3>20% off</h3><p>Applied to your first eligible REPLAY ticket.</p></article>
        <article class="info-card"><span class="info-card__kicker">Adventurer</span><h3>Up to ₹{edition?.pricing.adventurer_cap ?? 1000} off</h3><p>Applied to your first eligible REPLAY ticket.</p></article>
        <article class="info-card"><span class="info-card__kicker">Guildmaster</span><h3>Free ticket</h3><p>Applied to your first eligible REPLAY ticket.</p></article>
      </div>
    </div>
  </section>

  <section class="page-section page-section-blue" aria-labelledby="payment-heading">
    <div class="container-x">
      <span class="section-tag">Payment + confirmation</span>
      <h2 id="payment-heading" class="section-heading">What happens after you choose.</h2>
      <div class="info-grid">
        <article class="info-card"><span class="info-card__kicker">01</span><h3>Submit your details</h3><p>Choose the ticket and event day that works for you. Availability is checked again when you submit.</p></article>
        <article class="info-card"><span class="info-card__kicker">02</span><h3>Pay by UPI</h3><p>If money is due, the site opens a UPI payment step with a registration reference.</p></article>
        <article class="info-card"><span class="info-card__kicker">03</span><h3>Watch for email</h3><p>Paid registrations remain pending until payment is reviewed. Your confirmation email is your final ticket record.</p></article>
      </div>
      <p class="notice payment-notice">Cancellation and refund terms will be published before ticket sales open. If you need help with an existing registration, contact the REPLAY team.</p>
    </div>
  </section>

  <section id="ticket-action" class="ticket-action" aria-labelledby="ticket-action-heading">
    <div class="container-x ticket-action__inner">
      <span class="section-tag">{edition?.registration_status === 'open' ? 'Book now' : 'Ticket updates'}</span>
      <h2 id="ticket-action-heading" class="section-heading">
        {edition?.registration_status === 'open' ? 'Get your REPLAY ticket.' : 'Know when tickets move.'}
      </h2>
      {!edition ? (
        <p class="section-copy">There is no upcoming edition to register for right now. Follow REPLAY on Instagram for announcements.</p>
      ) : edition.registration_status === 'open' ? (
        <RegisterForm client:load edition={edition} upiId={upiId} />
      ) : (
        <div class="notify-card">
          <p>{statusCopy}</p>
          <NotifyMeForm client:load editionId={edition.id} editionName={edition.name} status={edition.registration_status} />
        </div>
      )}
    </div>
  </section>

  <section class="page-section page-section-soft">
    <div class="container-x two-column">
      <div>
        <h2 class="section-heading">Before you buy</h2>
        <p class="section-copy">Read the arrival guidance and current answers before committing to the weekend.</p>
      </div>
      <div class="button-row">
        <a href="/plan-your-visit" class="btn btn-secondary">Plan your visit →</a>
        <a href="/contact" class="btn btn-secondary">Questions? Contact us →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ticket-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 40px;
  }

  .ticket-card {
    padding: 28px;
    border: 4px solid var(--color-ink);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-lg);
  }

  .ticket-card--featured { background: var(--color-cream); }
  .ticket-card h3 { margin: 18px 0 0; font-size: 2rem; }
  .ticket-price { margin-top: 12px; font-family: var(--font-heading); font-size: clamp(2.5rem, 8vw, 4.5rem); font-weight: 800; line-height: 1; }
  .ticket-price-note { margin-top: 6px; color: rgba(26,26,26,.65); }
  .availability-card {
    margin-top: 28px;
    padding: 24px;
    border: 4px solid var(--color-ink);
    border-radius: var(--radius-lg);
    background: #fff;
  }
  .availability-card h3 { font-size: 1.4rem; }
  .availability-card > p { margin: 4px 0 18px; }

  .guild-grid { margin-top: 0; }
  .payment-notice { margin-top: 32px; }

  .ticket-action { background: var(--color-cream); border-top: 4px solid var(--color-ink); }
  .ticket-action__inner { padding: 72px 24px; }
  .notify-card { max-width: 640px; margin-top: 32px; padding: 28px; border: 4px solid var(--color-ink); border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow-md); }
  .notify-card > p { margin-bottom: 22px; }

  @media (min-width: 760px) {
    .ticket-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ticket-card { padding: 36px; }
  }
</style>
