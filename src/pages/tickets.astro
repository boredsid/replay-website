---
import Layout from '../layouts/Layout.astro';
import RegisterForm from '../components/RegisterForm';
import NotifyMeForm from '../components/NotifyMeForm';
import LiveSpotsBadge from '../components/LiveSpotsBadge';
import { getCurrentEdition, publicDateRange } from '../lib/data';
import { weekdayName } from '../lib/edition-format';

const edition = await getCurrentEdition();
const upiId = import.meta.env.PUBLIC_UPI_ID ?? '';
const title = 'Tickets — REPLAY';
const dateRange = edition ? publicDateRange(edition.start_date, edition.end_date) : '';
const day1Name = edition ? weekdayName(edition.start_date) : 'Day 1';
const day2Name = edition ? weekdayName(edition.end_date) : 'Day 2';
const statusCopy = edition?.registration_status === 'open'
  ? 'Choose a day ticket or make a full weekend of it.'
  : edition?.registration_status === 'sold_out'
    ? 'Tickets are currently sold out. Leave your number for any availability updates.'
    : edition?.registration_status === 'closed'
      ? 'Ticket sales for this edition are closed.'
      : 'Tickets are not open yet. Leave your number and the REPLAY team can contact you when they are.';
---

<Layout title={title} description="Book REPLAY tickets, check live availability, and find the essential information you need before buying.">
  <section id="ticket-action" class="ticket-action" aria-labelledby="ticket-action-heading">
    <div class="ticket-form-shell">
      <div class="ticket-form-frame">
        <div class="ticket-form-frame__accent" aria-hidden="true"></div>
        <div class="ticket-form-frame__content">
          {!edition ? (
            <div class="ticket-form-message">
              <span class="section-tag">Tickets</span>
              <h1 id="ticket-action-heading">Tickets are between editions.</h1>
              <p>There is no upcoming edition to register for right now. Follow REPLAY on Instagram for announcements.</p>
            </div>
          ) : edition.registration_status === 'open' ? (
            <>
              <header class="ticket-form-heading">
                <span class="section-tag">Book now</span>
                <h1 id="ticket-action-heading">Get your REPLAY ticket.</h1>
                <p>{dateRange} · {edition.venue}</p>
              </header>
              <RegisterForm client:load edition={edition} upiId={upiId} />
            </>
          ) : (
            <div class="ticket-form-message">
              <span class="section-tag">Ticket updates</span>
              <h1 id="ticket-action-heading">Know when tickets move.</h1>
              <p>{statusCopy}</p>
              <div class="ticket-notify">
                <NotifyMeForm client:load editionId={edition.id} editionName={edition.name} status={edition.registration_status} />
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {edition && (
    <section class="page-section page-section-yellow" aria-labelledby="availability-heading">
      <div class="availability-shell">
        <div class="availability-card">
          <span class="section-tag">Capacity</span>
          <h2 id="availability-heading">Live availability</h2>
          <p>Capacity is tracked separately for each event day.</p>
          <LiveSpotsBadge client:load editionId={edition.id} day1Label={day1Name} day2Label={day2Name} />
        </div>
      </div>
    </section>
  )}

  <section class="page-section page-section-soft">
    <div class="container-x two-column">
      <div>
        <h2 class="section-heading">Before you buy</h2>
        <p class="section-copy">Read the arrival guidance and current answers before committing to the weekend.</p>
      </div>
      <div class="button-row">
        <a href="/plan-your-visit" class="btn btn-secondary">Plan your visit →</a>
        <a href="/contact" class="btn btn-secondary">Questions? Contact us →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ticket-action {
    padding: 48px 20px 64px;
    background: var(--color-cream);
  }

  .ticket-form-shell,
  .availability-shell {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }

  .ticket-form-frame {
    overflow: hidden;
    border: 4px solid var(--color-ink);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-lg);
  }

  .ticket-form-frame__accent {
    height: 12px;
    border-bottom: 3px solid var(--color-ink);
    background: var(--color-orange);
  }

  .ticket-form-frame__content { padding: 24px; }

  .ticket-form-heading,
  .ticket-form-message {
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 3px solid var(--color-ink);
  }

  .ticket-form-heading h1,
  .ticket-form-message h1,
  .availability-card h2 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3rem);
    letter-spacing: -0.04em;
  }

  .ticket-form-heading p,
  .ticket-form-message > p {
    margin-top: 10px;
    color: rgba(26, 26, 26, 0.7);
  }

  .ticket-form-message {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }
  .ticket-notify { margin-top: 24px; }

  .availability-card {
    padding: 28px;
    border: 4px solid var(--color-ink);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-md);
  }
  .availability-card > p { margin: 8px 0 22px; }

  @media (min-width: 760px) {
    .ticket-action { padding: 72px 24px 88px; }
    .ticket-form-frame__content { padding: 40px; }
    .availability-card { padding: 36px; }
  }
</style>
