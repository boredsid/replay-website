---
import Layout from '../layouts/Layout.astro';
import DarkBand from '../components/DarkBand.astro';
import VenueMap from '../components/VenueMap.astro';
import { getCurrentEdition, publicDateRange } from '../lib/data';
import { clockTime, eventDayLabel } from '../lib/edition-format';

const edition = await getCurrentEdition();
const range = edition ? publicDateRange(edition.start_date, edition.end_date) : '';
const hours = edition ? `${clockTime(edition.daily_start_time)}–${clockTime(edition.daily_end_time)}` : '';
const venueConfirmed = Boolean(edition && edition.venue && edition.venue !== 'TBD');
const text = (value: string | null | undefined) => value?.trim() || null;
const venueAddress = text(edition?.venue_address);
const mapQuery = edition ? [edition.venue, venueAddress, 'Bangalore'].filter(Boolean).join(', ') : '';
const mapUrl = venueConfirmed
  ? text(edition?.google_maps_url) ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`
  : null;
const entranceDetails = text(edition?.entrance_details);
const checkInLocation = text(edition?.check_in_location);
const metroName = text(edition?.nearest_metro_name);
const metroDistance = text(edition?.nearest_metro_distance);
const busStopName = text(edition?.nearest_bus_stop_name);
const busStopDistance = text(edition?.nearest_bus_stop_distance);
const parkingAvailability = text(edition?.parking_availability);
const parkingCharges = text(edition?.parking_charges);
const foodDetails = text(edition?.food_details);
const waterDetails = text(edition?.water_details);
const accessibilityDetails = text(edition?.accessibility_details);
const libraryProcess = text(edition?.game_library_process);
const helpOnTheDay = text(edition?.help_on_the_day);
---

<Layout title="Plan Your Visit — REPLAY" description="Dates, hours, venue status, arrival guidance, accessibility, food, transport, and other practical information for REPLAY.">
  <DarkBand
    eyebrow="▸ PLAN YOUR VISIT"
    eyebrowColor="var(--color-yellow)"
    heading="Arrive ready to play."
    headingLevel="h1"
    body={edition ? `${range} · ${hours} each day. Everything confirmed about getting there and getting in lives on this page.` : 'Practical information for the next REPLAY edition will appear here.'}
    cta={edition ? { text: 'Get tickets →', href: '/tickets', variant: 'primary' } : undefined}
  />

  <section class="page-section page-section-yellow" aria-labelledby="essentials-heading">
    <div class="container-x">
      <span class="section-tag">Essentials</span>
      <h2 id="essentials-heading" class="section-heading">The details to save.</h2>
      {edition ? (
        <div class="info-grid">
          <article class="info-card">
            <span class="info-card__kicker">Dates</span>
            <h3>{range}</h3>
            <p>{eventDayLabel(edition.start_date)} and {eventDayLabel(edition.end_date)}</p>
          </article>
          <article class="info-card">
            <span class="info-card__kicker">Hours</span>
            <h3>{hours}</h3>
            <p>Daily event hours. Specific check-in and final-entry times will be published before tickets open.</p>
          </article>
          <article class="info-card">
            <span class="info-card__kicker">Venue</span>
            <h3>{venueConfirmed ? edition.venue : 'To be announced'}</h3>
            {venueAddress ? <p class="rich-copy">{venueAddress}</p> : <p>The full street address is still being confirmed.</p>}
            {mapUrl && <p><a class="text-link" href={mapUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a></p>}
          </article>
        </div>
      ) : (
        <p class="notice details-notice">No upcoming edition is published right now.</p>
      )}
    </div>
  </section>

  <section class="page-section page-section-paper" aria-labelledby="arrival-heading">
    <div class="container-x two-column">
      <div>
        <span class="section-tag">Arrival + check-in</span>
        <h2 id="arrival-heading" class="section-heading">From the door to your first table.</h2>
        <p class="section-copy">The ticket desk will use the phone number attached to your registration. Keep your confirmation email available as a second reference.</p>
      </div>
      <div>
        <ol class="arrival-steps">
          <li><strong>Find the REPLAY entrance.</strong><span class="rich-copy">{entranceDetails ?? 'The exact entrance and route from the street will be added with the venue plan.'}</span></li>
          <li><strong>Check in with your registered phone number.</strong><span class="rich-copy">{checkInLocation ?? 'The check-in desk location will be published before doors open.'}</span><span>Bring the confirmation email too, especially if someone else booked for you.</span></li>
          <li><strong>Ask for an orientation.</strong><span>New to board games or visiting alone? The team can help you find the library, schedule and a suitable table.</span></li>
        </ol>
      </div>
    </div>
  </section>

  <VenueMap />

  <section class="page-section page-section-blue" aria-labelledby="library-heading">
    <div class="container-x two-column">
      <div>
        <span class="section-tag">Game library</span>
        <h2 id="library-heading" class="section-heading">Borrow a game. Return with a favourite.</h2>
        <p class="section-copy">REPLAY has a shared library of 200+ games. You will be able to browse what is available, borrow a copy while you are at the convention, and return it to the library desk when you finish.</p>
      </div>
      <div class="info-card">
        <span class="info-card__kicker">Borrowing details</span>
        <h3>{libraryProcess ? 'How borrowing works.' : 'The circulation process is being prepared.'}</h3>
        <p class="rich-copy">{libraryProcess ?? 'Collection point, loan duration, return process, and the offline fallback will be published before doors open.'}</p>
      </div>
    </div>
  </section>

  <section class="page-section page-section-soft" aria-labelledby="venue-guide-heading">
    <div class="container-x">
      <span class="section-tag">Getting there</span>
      <h2 id="venue-guide-heading" class="section-heading">Choose your route.</h2>
      <p class="section-copy">Use the confirmed public-transport and parking details below when planning the journey.</p>
      <div class="info-grid">
        <article class="info-card">
          <span class="info-card__kicker">Metro</span>
          <h3>{metroName ?? 'Nearest Metro station'}</h3>
          <p>{metroDistance ?? 'Station and walking distance are being confirmed.'}</p>
        </article>
        <article class="info-card">
          <span class="info-card__kicker">Bus</span>
          <h3>{busStopName ?? 'Nearest bus stop'}</h3>
          <p>{busStopDistance ?? 'Stop and walking distance are being confirmed.'}</p>
        </article>
        <article class="info-card">
          <span class="info-card__kicker">Parking</span>
          <h3>Parking at or near the venue</h3>
          <p class="rich-copy">{parkingAvailability ?? 'Parking availability is being confirmed.'}</p>
          {parkingCharges && <p class="rich-copy"><strong>Charges:</strong> {parkingCharges}</p>}
        </article>
      </div>

      <span class="section-tag venue-services-tag">At the venue</span>
      <h2 class="section-heading section-heading-small">Food, water and access.</h2>
      <div class="info-grid">
        <article class="info-card"><span class="info-card__kicker">Food</span><h3>Eating during REPLAY</h3><p class="rich-copy">{foodDetails ?? 'On-site food, outside-food rules, and allergy guidance are being confirmed.'}</p></article>
        <article class="info-card"><span class="info-card__kicker">Water</span><h3>Stay hydrated</h3><p class="rich-copy">{waterDetails ?? 'Drinking-water and refill-point details are being confirmed.'}</p></article>
        <article class="info-card"><span class="info-card__kicker">Accessibility</span><h3>Plan around your needs</h3><p class="rich-copy">{accessibilityDetails ?? 'Step-free access, accessible toilets, seating, sensory considerations and accommodation contacts are being confirmed. Email us if you need to plan around a specific requirement.'}</p></article>
      </div>
      <p class="notice visit-notice">Age, guardian, re-entry, last-entry and prohibited-item policies are still being confirmed. Check this page again before travelling.</p>
    </div>
  </section>

  <section class="page-section page-section-purple" aria-labelledby="help-heading">
    <div class="container-x two-column">
      <div>
        <span class="section-tag">Need help?</span>
        <h2 id="help-heading" class="section-heading">Ask before the weekend.</h2>
        <p class="section-copy rich-copy">{helpOnTheDay ?? 'For ticket, accessibility, travel or venue questions, email the REPLAY team. The same-day help route will be added here once assigned.'}</p>
      </div>
      <div class="button-row">
        <a href="mailto:hello@replaycon.in" class="btn btn-black">Email hello@replaycon.in</a>
        <a href="/contact" class="btn btn-secondary">Read common answers →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .details-notice { margin-top: 28px; }
  .arrival-steps { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; counter-reset: arrival; }
  .arrival-steps li { position: relative; padding: 20px 20px 20px 70px; border: 3px solid var(--color-ink); border-radius: var(--radius-md); background: var(--color-cream); counter-increment: arrival; }
  .arrival-steps li::before { content: counter(arrival); position: absolute; top: 18px; left: 20px; width: 34px; height: 34px; display: grid; place-items: center; border: 2px solid var(--color-ink); border-radius: 50%; background: var(--color-orange); color: #fff; font-family: var(--font-heading); font-weight: 800; }
  .arrival-steps strong, .arrival-steps span { display: block; }
  .arrival-steps span { margin-top: 4px; color: rgba(26,26,26,.7); }
  .rich-copy { white-space: pre-line; }
  .venue-services-tag { margin-top: 48px; }
  .section-heading-small { max-width: 760px; }
  .visit-notice { margin-top: 32px; }
</style>
