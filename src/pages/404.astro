---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — REPLAY">
  <section class="section">
    <div class="container-x text-center max-w-xl mx-auto">
      <span class="pill pill-yellow mb-4">404</span>
      <h1 class="text-5xl md:text-6xl mb-4">Page not found</h1>
      <p class="text-gray-700 mb-8 text-lg">
        That route doesn&apos;t exist. Use the links below to get back to the current event information.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/tickets" class="btn btn-secondary">Tickets</a>
      </div>
    </div>
  </section>
</Layout>
