/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://qvkynwlmzeybdiapbcsy.supabase.co; connect-src 'self' https://api.replaycon.in; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  # `camera=(self)` rather than `camera=()`: the empty list disables the camera
  # for every origin including this one, which is what stopped the library
  # desk's QR scanner working. Chrome enforces this strictly; iOS Safari does
  # not apply it to getUserMedia, which is why it worked on a phone and not on
  # a laptop. Microphone, location and payment stay off -- nothing here uses
  # them, and the scanner asks for video only.
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be served stale: a cached copy keeps its own
# shell cache alive and would outlive the deploy that replaced it.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Icons are not content-hashed, so keep the edge TTL short enough that a
# regenerated set reaches browsers without waiting out a long cache.
/favicon-32.png
  Cache-Control: public, max-age=3600

/icon-192.png
  Cache-Control: public, max-age=3600

/icon-512.png
  Cache-Control: public, max-age=3600

/icon-maskable-512.png
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=3600
